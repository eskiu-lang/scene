// The headset showcase the examples draw (visionos/ through CompositorServices, quest/ through
// OpenXR): buttons in front of the viewer pick one of twelve scenes, each trying a part of
// eskiu-packages/scene in a headset (materials, lights and shadows, images and a 360 sky, video,
// glTF and VRX models with their animations, text, particles, physics, dragging, animation,
// a portal), over a lit floor. Pointing at a button and clicking (a Quest controller's
// trigger or a pinch, a visionOS pinch) opens its scene.
//
// The files the scenes show (images, the video's frames come from the host, models, a font)
// are in the directory xr_scene_set_assets names; a scene whose files are missing says so.
// Each view of each frame arrives as the system's color image (an id<MTLTexture> on
// visionOS, a VkImage on Quest), the view's pose in the world and the tangents of its field
// of view; the scene draws into that image with Scene_render_eye.
import <io>;
import <mem>;
import <libc>;
import <math>;
import <list>;
import <gpu>;
import <gpu/math>;
import <gpu/gltf>;
import <gpu/model>;
import <font/ttf>;
import <scene>;
import <scene/vr>;
import <gpu/external>;
import <scene/input>;
import <scene/text>;
import <scene/particles>;
import <scene/physics>;
import <scene/animation>;

const int XR_SCENES = 12;
const int XR_BASICS = 0;
const int XR_MATERIALS = 1;
const int XR_LIGHTS = 2;
const int XR_IMAGES = 3;
const int XR_VIDEO = 4;
const int XR_MODELS = 5;
const int XR_TEXT = 6;
const int XR_PARTICLES = 7;
const int XR_PHYSICS = 8;
const int XR_DRAG = 9;
const int XR_ANIMATION = 10;
const int XR_PORTAL = 11;

Gpu xr_gpu;
Scene xr_scene;
bool xr_open = false;
float xr_time = 0.0;
SceneDepthWriter xr_depth;
SceneInput xr_input;
SceneController xr_pointer;
bool xr_pointer_active = false;
int[2] xr_hands;
int[2] xr_lasers;
string xr_assets = null;
Font xr_font;
bool xr_has_font = false;

int xr_active = 0;
int[12] xr_roots;
int[12] xr_buttons;
int xr_button_mat;
int xr_button_on_mat;

// the scenes' moving parts
int[3] xr_boxes;
float[3] xr_angles;
bool[3] xr_paused;
int xr_orbit_light;
int xr_spot_light;
*GpuTexture xr_sky = null;
GpuTexture xr_video;
bool xr_has_video = false;
int xr_video_tex = 0;
int xr_video_mat = 0;
List<Gltf> xr_models;
List<SceneGltf> xr_model_nodes;
SceneParticleEmitter xr_fountain;
SceneParticleEmitter xr_fire;
ScenePhysicsWorld xr_world;
List<int> xr_crates;
List<int> xr_crate_bodies;
List<Vec3> xr_crate_homes;
double xr_next_ball = 0.0;
int xr_ball_mesh;
int xr_ball_mat;
SceneAnimations xr_anims;

string xr_name(int i) {
    string[12] names = {"Basics", "Materials", "Lights", "Images", "Video", "Models", "Text", "Particles", "Physics",
        "Drag", "Animation", "Portal"};
    return names[i];
}

// A path in the assets directory (a String the caller frees).
String _xr_asset(string name) {
    String p;
    if (xr_assets != null) p.appendf("%s/%s", xr_assets, name);
    else p.append(name);
    return p;
}

// A material of lighting model lighting and color c.
int _xr_material(int lighting, Vec4 c) {
    SceneMaterial m = scene_material(lighting);
    m.diffuse = c;
    return xr_scene.add_material(m);
}

Result<int, string> _xr_mesh(SceneGeometry g) {
    SceneGeometry geo = g;
    int mesh = xr_scene.add_geometry(&geo)?;
    geo.free();
    return Ok<int, string>(mesh);
}

// Text at x, y, z under parent, centered in a w x h box; 0 without a font.
Result<int, string> _xr_text(int parent, string text, float size, Vec4 color, float x, float y, float z, float w, float h) {
    if (!xr_has_font) return Ok<int, string>(0);
    SceneTextStyle st = scene_text_style();
    st.size = size;
    st.color = color;
    st.width = w;
    st.height = h;
    st.align = SCENE_TEXT_CENTER;
    st.valign = SCENE_TEXT_MIDDLE;
    SceneText t = xr_scene.add_text(parent, &xr_font, text, st)?;
    xr_scene.node(t.node).position = Vec3{x, y, z};
    xr_scene.node(t.node).ignore_events = true;
    return Ok<int, string>(t.node);
}

Result<int, string> _xr_title(int parent, string text, float y, float z) {
    return _xr_text(parent, text, 9.0, Vec4{0.85, 0.9, 1.0, 1.0}, 0.0, y, z, 2.0, 0.15);
}

void _xr_font() {
    string[4] paths = {"Roboto.ttf", "/system/fonts/Roboto-Regular.ttf", "/System/Library/Fonts/Supplemental/Arial.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"};
    for (i in 0..4) {
        String p;
        if (i == 0) p = _xr_asset(paths[0]);
        else p.append(paths[i]);
        Result<Font, string> f = font_load((string)p.data);
        p.free();
        if (f.ok != 0) {
            xr_font = f.value;
            xr_has_font = true;
            return;
        }
    }
    println_err("xr: no font found, the showcase has no labels");
}

import "xr_scene_menu.esk";
import "xr_scene_host.esk";
