// The scene the headset examples draw (visionos/ through CompositorServices, quest/ through
// OpenXR): a red, a green and a blue box in front of the viewer and a lit floor, turning
// slowly; pointing at a box and clicking (a Quest controller's trigger, a visionOS pinch)
// stops or restarts its turn. Each view of each frame arrives as the system's color image (an id<MTLTexture> on
// visionOS, a VkImage on Quest), the view's pose in the world and the tangents of its field
// of view; the scene draws into that image with Scene_render_eye.
import <io>;
import <mem>;
import <libc>;
import <math>;
import <gpu>;
import <gpu/math>;
import <scene>;
import <scene/vr>;
import <scene/input>;

Gpu xr_gpu;
Scene xr_scene;
bool xr_open = false;
int[3] xr_boxes;
float xr_time = 0.0;
SceneDepthWriter xr_depth;
SceneInput xr_input;
SceneController xr_pointer;
bool xr_pointer_active = false;
float[3] xr_angles;
bool[3] xr_paused;

void _xr_clicked(*SceneEvent e) {
    if (e.kind != SCENE_EVENT_CLICK || e.state != SCENE_CLICKED) return;
    for (i in 0..3) {
        if (xr_boxes[i] == e.node) xr_paused[i] = !xr_paused[i];
    }
}

Result<int, string> _xr_build() {
    xr_gpu = gpu_open()?;
    xr_scene = xr_gpu.scene()?;
    xr_scene.background = Vec4{0.05, 0.06, 0.09, 1.0};
    SceneGeometry box = scene_box(0.3, 0.3, 0.3);
    int box_mesh = xr_scene.add_geometry(&box)?;
    box.free();
    Vec4[3] colors = {Vec4{0.9, 0.1, 0.1, 1.0}, Vec4{0.1, 0.8, 0.2, 1.0}, Vec4{0.15, 0.3, 0.95, 1.0}};
    for (i in 0..3) {
        SceneMaterial m = scene_material(SCENE_BLINN);
        m.diffuse = colors[i];
        xr_boxes[i] = xr_scene.add_object(0, box_mesh, xr_scene.add_material(m));
        xr_scene.node(xr_boxes[i]).position = Vec3{((float)i - 1.0) * 0.6, 1.2, -1.8};
    }
    SceneGeometry floor = scene_box(6.0, 0.02, 6.0);
    int floor_mesh = xr_scene.add_geometry(&floor)?;
    floor.free();
    SceneMaterial fm = scene_material(SCENE_LAMBERT);
    fm.diffuse = Vec4{0.45, 0.45, 0.5, 1.0};
    xr_scene.add_object(0, floor_mesh, xr_scene.add_material(fm));
    SceneLight sun = scene_directional(Vec3{0.3, -1.0, -0.4}, Vec3{1.0, 1.0, 1.0}, 1.0);
    xr_scene.add_light(sun);
    SceneLight fill = scene_ambient(Vec3{0.25, 0.25, 0.3}, 1.0);
    xr_scene.add_light(fill);
    int cam = xr_scene.add_camera(0, scene_perspective(1.0, 0.05, 50.0));
    xr_scene.set_camera(cam);
    xr_input = scene_input();
    for (i in 0..3) xr_input.on(xr_boxes[i], SCENE_ON_CLICK, _xr_clicked);
    xr_pointer = scene_controller(&xr_scene, SCENE_CONTROLLER_POINTER);
    xr_pointer.show_reticle(false);
    return Ok<int, string>(0);
}

// Opens the GPU (on visionOS the system default Metal device, the compositor's; on Quest
// Vulkan, whose objects xr_scene_vulkan gives the OpenXR session) and builds the scene.
// 0 on success.
export int xr_scene_open() {
    if (xr_open) return 0;
    Result<int, string> r = _xr_build();
    if (r.ok == 0) {
        println_err(r.error);
        return 1;
    }
    xr_open = true;
    return 0;
}

// Advances the animation by dt seconds, and the pointer's hover and reticle when it is
// active.
export void xr_scene_step(float dt) {
    xr_time += dt;
    for (i in 0..3) {
        if (!xr_paused[i]) xr_angles[i] += dt * (0.6 + 0.3 * (float)i);
        xr_scene.node(xr_boxes[i]).rotation = quat_axis_angle(Vec3{0.3, 1.0, 0.1}.normalize(), xr_angles[i]);
    }
    if (xr_pointer_active) {
        Result<int, string> r = xr_pointer.update(&xr_scene, &xr_input, (double)xr_time);
        if (r.ok == 0) println_err(r.error);
    }
}

// The rotation that turns -Z to the unit direction d.
Quat _xr_aim(Vec3 d) {
    Vec3 f = Vec3{0.0, 0.0, -1.0};
    float c = f.dot(d);
    if (c > 0.9999) return quat_identity();
    if (c < -0.9999) return quat_axis_angle(Vec3{0.0, 1.0, 0.0}, 3.14159265);
    return quat_axis_angle(f.cross(d).normalize(), (float)acos((double)c));
}

// The pointer: a ray from (ox, oy, oz) along (dx, dy, dz) in world space (a Quest
// controller's aim pose, a visionOS pinch's selection ray), down while its button (trigger,
// pinch) is held. active false hides the reticle and ends the pointer's hover.
export void xr_scene_pointer(float ox, float oy, float oz, float dx, float dy, float dz, bool down, bool active) {
    if (!xr_open) return;
    if (!active) {
        if (xr_pointer_active) {
            xr_pointer.button(&xr_scene, &xr_input, false);
            xr_pointer.show_reticle(false);
        }
        xr_pointer_active = false;
        return;
    }
    if (!xr_pointer_active) xr_pointer.show_reticle(true);
    xr_pointer_active = true;
    xr_pointer.set_pose(Vec3{ox, oy, oz}, _xr_aim(Vec3{dx, dy, dz}.normalize()));
    SceneRay ray = xr_pointer.ray(&xr_scene);
    xr_input.pointer(&xr_scene, ray, (double)xr_time);
    xr_pointer.button(&xr_scene, &xr_input, down);
}

const float XR_NEAR = 0.1;
const float XR_FAR = 50.0;

Result<GpuTexture, string> _xr_wrap(uint64 image, uint32 width, uint32 height, int format) {
#ifdef __APPLE__
    return xr_gpu.texture_from_metal((*void)image, width, height, (WGPUTextureFormat)format, 1, 0);
#else
    return xr_gpu.texture_from_vulkan(image, width, height, (WGPUTextureFormat)format, 1, 0);
#endif
}

// Draws one view into the system's color image of width x height: an id<MTLTexture>
// (visionOS) or a VkImage (Quest) in image, of wgpu format format. pose is the view's world
// transform, 16 floats column by column; left, right, top and bottom are the tangents of
// its field of view's half angles. depth_image (0 for none) is the system's depth image of
// the same size and wgpu format depth_format, which gets the view's depth for reprojection,
// reversed (1 at near) when reverse is true; the planes are XR_NEAR and XR_FAR. 0 on success.
export int xr_scene_render(uint64 image, uint32 width, uint32 height, int format, *float pose,
        float left, float right, float top, float bottom, uint64 depth_image, int depth_format, bool reverse) {
    if (!xr_open) return 1;
    Result<GpuTexture, string> t = _xr_wrap(image, width, height, format);
    if (t.ok == 0) {
        println_err(t.error);
        return 1;
    }
    GpuTexture target = t.value;
    SceneEye eye;
    for (i in 0..16) eye.pose.m[i] = pose[i];
    eye.near = XR_NEAR;
    eye.far = XR_FAR;
    eye.projection = scene_fov_projection(-(float)atan((double)fabs(left)), (float)atan((double)fabs(right)),
        -(float)atan((double)fabs(bottom)), (float)atan((double)fabs(top)), eye.near, eye.far);
    Result<int, string> r = xr_scene.render_eye(&target, eye);
    if (r.ok != 0 && depth_image != 0) {
        Result<GpuTexture, string> dt = _xr_wrap(depth_image, width, height, depth_format);
        if (dt.ok == 0) {
            r = Err<int, string>(dt.error);
        } else {
            GpuTexture depth = dt.value;
            r = xr_depth.write(&xr_scene, &target, &depth, reverse);
            depth.release();
        }
    }
    target.release();
    if (r.ok == 0) {
        println_err(r.error);
        return 1;
    }
    return 0;
}

#ifndef __APPLE__
// The Vulkan instance, physical device, device and queue (family and index) the scene draws
// with, for XrGraphicsBindingVulkanKHR. 0 on success.
export int xr_scene_vulkan(**void instance, **void physical_device, **void device, *uint32 queue_family, *uint32 queue_index) {
    if (!xr_open) return 1;
    Result<WGPUVulkanHandles, string> h = xr_gpu.vulkan_handles();
    if (h.ok == 0) {
        println_err(h.error);
        return 1;
    }
    *instance = h.value.instance;
    *physical_device = h.value.physical_device;
    *device = h.value.device;
    *queue_family = h.value.queue_family_index;
    *queue_index = h.value.queue_index;
    return 0;
}
#endif

// Waits until the GPU has run what was submitted, so the compositor presents finished views.
export void xr_scene_wait() {
    xr_gpu.wait();
}
