// light.esk: lights (`<scene/light>`).
//
// A light is ambient, directional, point or spot. Directional, point and spot
// lights may hang from a node: position and direction are then in the node's
// space and move with it. Each drawn node takes up to 8 of them (the
// directional ones first, then the nearest point and spot lights whose range
// reaches it); ambient lights are summed and light everything.
//
//     int sun = scene.add_light(scene_directional(Vec3{-0.3, -1.0, -0.4}, Vec3{1.0, 0.95, 0.9}, 2.0));
//     scene.light(sun).casts_shadows = true;
//     int lamp = scene.add_light(scene_point(Vec3{0.0, 2.0, 0.0}, Vec3{1.0, 0.6, 0.3}, 3.0, 0.5, 6.0));
//
// Intensity multiplies the color: a white light of intensity 1 straight onto
// a white Lambert surface lights it to 1. (ViroReact's lights in lumens are
// 1000 times larger.)

import <libc>;
import <gpu/math>;

// Light types (SceneLight.type).
const int SCENE_LIGHT_AMBIENT = 0;
const int SCENE_LIGHT_DIRECTIONAL = 1;
const int SCENE_LIGHT_POINT = 2;
const int SCENE_LIGHT_SPOT = 3;

// The most lights a scene sends to the GPU at once (beyond them, lights are skipped in
// the order they were added), and the most a single draw is lit by.
const int SCENE_MAX_LIGHTS = 64;
const int SCENE_LIGHTS_PER_DRAW = 8;

// The most shadow-casting lights at once (one layer each of the shadow map array).
const int SCENE_MAX_SHADOWS = 4;

// A light:
// - type: one of SCENE_LIGHT_*; enabled turns it on.
// - color (linear RGB) times intensity is the light's strength.
// - position (point, spot) and direction (directional, spot; it points from the light
//   toward what it lights) are in node's space, or the world's when node is -1.
// - attenuation_start, attenuation_end, falloff (point, spot): full strength up to start,
//   none from end, and 1 - t^(1/falloff) in between, with t going from 0 at start to 1 at
//   end (falloff 1 is linear, 2 the default).
// - inner_angle and outer_angle (spot): angles from the axis in radians; full strength
//   inside the inner one, fading to none at the outer one.
// - influence: a bit mask; the light reaches nodes whose light_mask shares a bit.
// - casts_shadows (directional): the light gets a layer of the scene's shadow map array
//   (Scene.shadow_size texels square), compared with shadow_bias (in the light box's
//   depth units) after moving the point shadow_normal_bias texels along its normal; shadow_opacity 1 is a black
//   shadow, 0 none. shadow_radius > 0 sets the cube the light sees (half-size, around
//   shadow_center, in world space); 0 fits the visible nodes.
struct SceneLight {
    int type;
    bool enabled;
    Vec3 color;
    float intensity;
    int node;
    Vec3 position;
    Vec3 direction;
    float attenuation_start;
    float attenuation_end;
    float falloff;
    float inner_angle;
    float outer_angle;
    uint32 influence;
    bool casts_shadows;
    float shadow_bias;
    float shadow_normal_bias;
    float shadow_opacity;
    float shadow_radius;
    Vec3 shadow_center;
}

SceneLight _scene_light(int type, Vec3 color, float intensity) {
    return SceneLight{type: type, enabled: true, color: color, intensity: intensity, node: -1,
        direction: Vec3{0.0, 0.0, -1.0}, attenuation_end: 10.0, falloff: 2.0, inner_angle: 0.35,
        outer_angle: 0.5, influence: 1, shadow_bias: 0.002, shadow_normal_bias: 1.5, shadow_opacity: 1.0};
}

// An ambient light: color * intensity added to every lit surface's diffuse color.
SceneLight scene_ambient(Vec3 color, float intensity) {
    return _scene_light(SCENE_LIGHT_AMBIENT, color, intensity);
}

// A directional light (a sun) shining along direction.
SceneLight scene_directional(Vec3 direction, Vec3 color, float intensity) {
    SceneLight l = _scene_light(SCENE_LIGHT_DIRECTIONAL, color, intensity);
    l.direction = direction.normalize();
    return l;
}

// A point light at position, at full strength up to start and none past end.
SceneLight scene_point(Vec3 position, Vec3 color, float intensity, float start, float end) {
    SceneLight l = _scene_light(SCENE_LIGHT_POINT, color, intensity);
    l.position = position;
    l.attenuation_start = start;
    l.attenuation_end = end;
    return l;
}

// A spot light at position pointing along direction, with a full-strength cone of inner
// radians around its axis fading out at outer radians, and range start to end as a point
// light's.
SceneLight scene_spot(Vec3 position, Vec3 direction, Vec3 color, float intensity, float inner, float outer,
                      float start, float end) {
    SceneLight l = _scene_light(SCENE_LIGHT_SPOT, color, intensity);
    l.position = position;
    l.direction = direction.normalize();
    l.inner_angle = inner;
    l.outer_angle = outer;
    l.attenuation_start = start;
    l.attenuation_end = end;
    return l;
}

// The share of a point or spot light's strength left at distance from it (1 to 0), as the
// shader computes it; 1 for the other types.
float SceneLight_attenuation(const SceneLight* self, float distance) {
    if (self.type != SCENE_LIGHT_POINT && self.type != SCENE_LIGHT_SPOT) return 1.0;
    float range = self.attenuation_end - self.attenuation_start;
    if (range < 1e-4) range = 1e-4;
    float d = (distance - self.attenuation_start) / range;
    if (d <= 0.0) return 1.0;
    if (d >= 1.0) return 0.0;
    float f = self.falloff < 1e-3 ? 1e-3 : self.falloff;
    return 1.0 - (float)pow((double)d, 1.0 / (double)f);
}

// The share of a spot light's strength at angle radians from its axis (1 inside the inner
// angle, 0 outside the outer one, linear in the cosine between); 1 for the other types.
float SceneLight_cone(const SceneLight* self, float angle) {
    if (self.type != SCENE_LIGHT_SPOT) return 1.0;
    float ci = (float)cos((double)self.inner_angle);
    float co = (float)cos((double)self.outer_angle);
    float w = ci - co;
    if (w < 1e-4) w = 1e-4;
    float t = ((float)cos((double)angle) - co) / w;
    if (t < 0.0) return 0.0;
    if (t > 1.0) return 1.0;
    return t;
}
