// scene.esk: a scene graph and its renderer over `<gpu>`.
//
// A Scene holds nodes in a tree (each with a position, a rotation and a scale,
// and optionally a mesh with a material, or a camera), lights, textures and
// the settings of the final image. Scene_render draws it: shadow maps, the
// opaque surfaces front to back, the sky, the transparent surfaces back to
// front, all in linear HDR, then bloom, tone mapping and gamma into the
// target (a window frame or a texture).
//
//     Scene scene = gpu.scene()?;
//     defer scene.release();
//     SceneGeometry ball = scene_sphere(1.0, 48, 24);
//     int mesh = scene.add_geometry(&ball)?;
//     ball.free();
//     SceneMaterial m = scene_material(SCENE_PBR);
//     m.diffuse = Vec4{0.9, 0.2, 0.1, 1.0};
//     int node = scene.add_object(0, mesh, scene.add_material(m));
//     scene.add_light(scene_directional(Vec3{-0.5, -1.0, -0.3}, Vec3{1.0, 1.0, 1.0}, 2.0));
//     int cam = scene.add_camera(0, scene_perspective(0.9, 0.1, 100.0));
//     scene.node(cam).position = Vec3{0.0, 1.0, 4.0};
//     scene.look_at(cam, Vec3{0.0, 0.0, 0.0}, Vec3{0.0, 1.0, 0.0});
//     scene.set_camera(cam);
//     ...each frame:
//     scene.render(frame.view, surface.width, surface.height, surface.format)?;
//
// Ids: node 0 is the root, and every node descends from it. Meshes, materials
// and textures are numbered from 1; 0 in a node's mesh is no mesh, in its
// material the scene's default material (white Blinn), and in a material's
// texture field no texture. Lights are numbered from 0. Pointers from node(),
// material() and light() are good until the next node, material or light is
// added.

import <io>;
import <mem>;
import <string>;
import <list>;
import <result>;
import <libc>;
import <sort>;
import <gpu/raw>;
import <gpu/core>;
import <gpu/render>;
import <gpu/math>;
import <gpu/gltf>;
import <gpu/image>;
import <gpu/ibl>;
import <scene/geometry>;
import <scene/material>;
import <scene/light>;
import <scene/post>;
import <scene/sky>;

// Camera projections (SceneCamera.projection).
const int SCENE_PERSPECTIVE = 0;
const int SCENE_ORTHOGRAPHIC = 1;
// A camera with a given projection matrix (SceneCamera.matrix), as an AR session gives it.
const int SCENE_CUSTOM = 2;

// A camera, attached to a node: it sits at the node's origin and looks down the node's -Z
// axis with +Y up. fov is the vertical field of view in radians (perspective), height the
// visible height in world units (orthographic), near and far the clipping distances, and
// aspect the width over height (0 takes the target's).
struct SceneCamera {
    int projection;
    float fov;
    float near;
    float far;
    float height;
    float aspect;
    Mat4 matrix;
}

// A camera with projection matrix (depth 0 at near to 1 at far, as eskiu-gpu's); near and
// far are what the matrix was made with.
SceneCamera scene_projection(Mat4 matrix, float near, float far) {
    SceneCamera c = SceneCamera{SCENE_CUSTOM, 1.0, near, far, 0.0, 0.0};
    c.matrix = matrix;
    return c;
}

// A perspective camera with a vertical field of view of fov radians.
SceneCamera scene_perspective(float fov, float near, float far) {
    return SceneCamera{SCENE_PERSPECTIVE, fov, near, far, 0.0, 0.0};
}

// An orthographic camera that sees height world units from the bottom of the image to the
// top.
SceneCamera scene_orthographic(float height, float near, float far) {
    return SceneCamera{SCENE_ORTHOGRAPHIC, 0.0, near, far, height, 0.0};
}

// The depth format of the scene pass: with a stencil, for portals.
const WGPUTextureFormat SCENE_DEPTH_FORMAT = WGPUTextureFormat_Depth24PlusStencil8;

// Pipeline key bits beyond the material's (scene_material_key): drawn only where the
// stencil equals the pass's reference (a portal's world), or into the stencil (a portal's
// window).
const int _SCENE_KEY_MASKED = 4096;
const int _SCENE_KEY_SILHOUETTE = 8192;

// How a node turns to face the camera (SceneNode.billboard), ViroReact's
// transformBehaviors: not at all; fully (its +Z toward the camera); or only about the
// world X, Y or Z axis.
const int SCENE_BILLBOARD_NONE = 0;
const int SCENE_BILLBOARD_ALL = 1;
const int SCENE_BILLBOARD_X = 2;
const int SCENE_BILLBOARD_Y = 3;
const int SCENE_BILLBOARD_Z = 4;

// A node. position, rotation and scale place it in its parent's space (the local matrix is
// translation * rotation * scale); world is its world matrix after the last
// Scene_update or render. A node that is not visible hides its whole subtree. mesh,
// material and camera are ids (0, 0 and -1 when it has none); casts_shadows and
// receives_shadows choose its part in shadows, and light_mask the lights that reach it
// (SceneLight.influence). opacity (1) fades the node and its subtree: it multiplies down
// the tree, a node below 1 is drawn blended (after the opaque surfaces, sorted back to
// front, casting no shadow), and one at 0 is not drawn. rendering_order (0) draws the node
// before (lower) or after (higher) others whatever its distance, ahead of every other
// ordering; with a material that skips the depth test it puts a panel on top. billboard
// (SCENE_BILLBOARD_*) turns the node to face the camera. portal makes the node's subtree a
// world of its own, seen through the meshes of its descendants marked portal_entrance
// (ViroPortalScene and ViroPortal), with portal_sky (a texture id: a cube, or a 360 image
// with portal_sky_pano) behind it and portal_ibl (a GpuIbl, not owned) lighting its PBR
// materials, as ViroReact's per-portal lighting environment (none: the ambient lights);
// passable lets the camera walk in. ignore_events keeps the node's mesh out of hit tests
// (<scene/input>): rays pass through it. alive is false once the node is removed. Change
// parent and children through Scene_set_parent and Scene_remove, not by hand.
struct SceneNode {
    String name;
    int parent;
    List<int> children;
    Vec3 position;
    Quat rotation;
    Vec3 scale;
    // the points rotation and scale turn and grow about, in the node's own space
    // (ViroReact's rotationPivot and scalePivot); has_pivot when either is set
    Vec3 rotation_pivot;
    Vec3 scale_pivot;
    bool has_pivot;
    bool visible;
    bool alive;
    int mesh;
    int material;
    int camera;
    bool casts_shadows;
    bool receives_shadows;
    uint32 light_mask;
    float opacity;
    int rendering_order;
    int billboard;
    bool portal;
    bool portal_entrance;
    bool passable;
    int portal_sky;
    bool portal_sky_pano;
    *GpuIbl portal_ibl;
    bool ignore_events;
    // hit tests against its and its descendants' triangles instead of bounds (needs Scene.keep_mesh_copies
    // when the mesh is made; ViroReact's highAccuracyEvents)
    bool precise_hits;
    Mat4 world;
    List<Mat4> joints;
    List<float> weights;
    List<Mat4> instances;
}

// A mesh on the GPU: its vertex and index buffers, the index count and the bounds of its
// positions.
struct SceneMesh {
    GpuBuffer vertices;
    GpuBuffer indices;
    uint32 index_count;
    Vec3 min;
    Vec3 max;
    uint32 vertex_count;
    int targets;
    GpuBuffer morph;
    // the positions (3 floats a vertex) and indices kept on the CPU when Scene.keep_mesh_copies
    // is set, for hit tests against the triangles (SceneNode.precise_hits)
    List<float> cpu_positions;
    List<uint32> cpu_indices;
}

// A glTF model added with Scene_add_gltf: root is the node holding it; nodes maps each glTF
// node to its scene node (0 when it is outside the scene); meshes holds the scene mesh of
// each glTF primitive, mesh by mesh (prim_start[m] is mesh m's first); materials and
// textures the ids made for the file's materials and images.
struct SceneGltf {
    int root;
    List<int> nodes;
    List<int> meshes;
    List<int> prim_start;
    List<int> materials;
    List<int> textures;
    List<int> prim_nodes;
    List<int> prim_src;
    List<int> prim_skin;
    int material_version;
}

struct _SceneNodeGpu {
    bool made;
    GpuBuffer uniforms;
    GpuBindGroup group;
    GpuBuffer joints;
    GpuBuffer weights;
    GpuBuffer instances;
    int bound_mesh;
}

struct _SceneMatGpu {
    bool made;
    GpuBuffer uniforms;
    GpuBindGroup group;
    int[6] bound;
    int sampler;
    List<float> mod_values;
    List<int> mod_textures;
    int mod_shader;
    bool mod_made;
    GpuBuffer mod_buffer;
    GpuBindGroup mod_group;
}

// A shader program's bind layout (group 3: its uniforms, a sampler, its textures).
struct _SceneShaderGpu {
    bool made;
    GpuBindLayout layout;
}

struct _SceneSampler {
    int key;
    GpuSampler samp;
}

struct _ScenePipe {
    int key;
    GpuPipeline pipe;
}

struct _SceneDraw {
    int node;
    int mesh;
    int material;
    int key;
    bool blend;
    float depth;
    Vec3 center;
    float radius;
    float opacity;
    int order;
    bool in_view;
    int world;
    int frame;
}

struct _ScenePortalRec {
    int node;
    int outer;
    int group;
}

// The frame bind group of a portal's world: the frame's values with that world's lighting
// environment.
struct _SceneWorldGroup {
    *GpuIbl ibl;
    GpuBuffer frame;
    GpuBindGroup group;
}

struct _SceneLightRec {
    int light;
    int type;
    Vec3 pos;
    Vec3 dir;
    float end;
    uint32 mask;
    int layer;
}

struct _SceneDrawU {
    Mat4 model;
    Mat4 normal;
    uint32[8] lights;
    float[4] info;
    float[4] morph;
}

struct _SceneRenderer {
    GpuBindLayout frame_layout;
    GpuBindLayout draw_layout;
    GpuBindLayout mat_layout;
    GpuBindLayout shadow_layout;
    GpuBuffer frame;
    GpuBuffer lights;
    GpuBindGroup frame_group;
    GpuSampler samp;
    GpuBuffer no_storage;
    GpuSampler shadow_samp;
    GpuSampler ibl_samp;
    GpuTexture white;
    GpuTexture black_cube;
    GpuTexture no_shadow;
    GpuTexture shadow_maps;
    uint32 shadow_size;
    uint32 shadow_layers;
    List<GpuTextureView> shadow_views;
    List<GpuBuffer> shadow_bufs;
    List<GpuBindGroup> shadow_groups;
    GpuPipeline shadow_pipe;
    List<_ScenePipe> pipes;
    List<_ScenePipe> shadow_pipes;
    GpuTexture depth_prev;
    GpuTextureView depth_prev_view;
    GpuTextureView depth_view;
    GpuTexture hdr;
    GpuTexture depth;
    uint32 w;
    uint32 h;
    List<_SceneNodeGpu> nodes;
    List<_SceneMatGpu> mats;
    List<_SceneSampler> samplers;
    List<_ScenePortalRec> portals;
    List<_SceneShaderGpu> shader_gpu;
    List<_SceneWorldGroup> world_groups;
    Vec3 last_eye;
    bool has_eye;
    GpuPipeline depth_reset;
    bool depth_reset_made;
    GpuBindLayout occ_layout;
    GpuPipeline occ_pipe;
    GpuBuffer occ_uniforms;
    GpuBindGroup occ_group;
    bool occ_made;
    // selective bloom: the marked materials alone over the depth of the rest
    GpuTexture bloom_src;
    GpuTexture bloom_depth;
    uint32 bloom_w;
    uint32 bloom_h;
    GpuPipeline bloom_pre;
    GpuBuffer bloom_buf;
    GpuBindGroup bloom_group;
    bool bloom_made;
    // per-material thresholds: each marked surface drawn again subtracting its threshold's excess
    // over post.bloom_threshold from the bloom source (one value buffer per draw)
    GpuBindLayout bloom_sub_layout;
    GpuPipeline bloom_sub;
    List<GpuBuffer> bloom_sub_bufs;
    List<GpuBindGroup> bloom_sub_groups;
    // multisampling: the sample count the pipelines were made with, the multisampled targets
    // (color and depth of the scene's pass and of the bloom source) and the depth resolve
    uint32 samples;
    uint32 ms_w;
    uint32 ms_h;
    uint32 ms_n;
    GpuTexture ms_color;
    GpuTexture ms_depth;
    GpuTexture ms_bloom;
    GpuTexture ms_bloom_depth;
    GpuTextureView ms_depth_view;
    GpuBindLayout ms_resolve_layout;
    GpuPipeline ms_resolve;
    bool ms_resolve_made;
    List<_SceneDraw> draws;
    List<_SceneLightRec> recs;
    _ScenePostGpu post;
    _SceneSkyGpu sky;
    WGPUTextureView bound_shadow;
    WGPUTextureView bound_irr;
    Mat4 view_proj;
    Mat4 view;
    Mat4 proj;
    Vec3 eye;
    Vec3 forward;
    bool ortho;
    bool made;
}

// A scene and its renderer. background is the linear color behind everything when there
// is no skybox; skybox (with sky_intensity, and sky_flip for a cube of six images, sky_pano
// for a 360 image) is set by Scene_set_skybox, Scene_set_skybox_faces, Scene_set_sky_360 or
// Scene_load_sky_360, and sky_rotation turns it; ibl by Scene_set_ibl; post holds
// the tone mapping, gamma and bloom settings; shadow_size is the width and height of each
// shadow map (2048). camera is the node of the camera that renders (-1 is a default camera
// at the origin looking down -Z). The lists are the scene's objects by id. camera_texture
// (a texture id) and camera_image_transform are what shader modifiers get as camera_texture
// and camera_image_transform (ViroReact's AR camera image and its mapping from the view's
// coordinates): an AR session sets them each frame. camera_background (a texture id, 0 for
// none) is shown behind what the scene draws, as it is (not tone mapped): the scene goes over
// it as premultiplied color (with a background of alpha 0), so opaque surfaces cover it,
// blended ones mix with it and additive ones glow on it: the AR camera picture, already
// fitted to the view. occlusion_depth (a texture id, 0 for none) is the real world's depth,
// in meters, in its red channel (R32Float or R16Float, 0 where unknown), as an AR session
// measures it: virtual content farther than the real surface at a pixel is hidden there
// (ViroReact's DepthBased occlusion). occlusion_transform maps the view's coordinates (x, y
// from 0 to 1, from the top left) to the depth image's. semantic_texture (a texture id, an
// R8Unorm image holding a label per pixel, as an AR session's scene semantics give it) and
// semantic_confidence_texture (its confidence, 0 to 1; white for none), with
// semantic_transform from the view's coordinates to theirs, are what semantic masks read
// (scene_semantic_mask).
struct Scene {
    Gpu gpu;
    List<SceneNode> nodes;
    List<SceneCamera> cameras;
    List<SceneMesh> meshes;
    List<SceneMaterial> materials;
    List<SceneShader> shaders;
    List<GpuTexture> textures;
    List<bool> _borrowed;
    List<SceneLight> lights;
    int camera;
    Vec4 background;
    *GpuTexture skybox;
    float sky_intensity;
    bool sky_flip;
    GpuTexture sky_faces;
    bool sky_pano;
    Quat sky_rotation;
    *GpuIbl ibl;
    ScenePost post;
    // multisample antialiasing: samples per pixel of the scene's pass (0 or 1 none, else 4,
    // the count every WebGPU device supports); its depth is resolved for what reads it after
    int msaa;
    uint32 shadow_size;
    int active_portal;
    int camera_texture;
    Mat4 camera_image_transform;
    int camera_background;
    int occlusion_depth;
    Mat4 occlusion_transform;
    int semantic_texture;
    int semantic_confidence_texture;
    Mat4 semantic_transform;
    // keep each mesh's positions and indices on the CPU too (for SceneNode.precise_hits)
    bool keep_mesh_copies;
    _SceneRenderer _r;
}

import "scene_nodes.esk";
import "scene_assets.esk";
import "scene_gpu.esk";
import "scene_render.esk";
