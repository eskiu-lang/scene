// text.esk: text in the scene (`<scene/text>`).
//
// A text node draws a string of a TrueType font (eskiu-lang/font) as glyph quads facing
// +Z, laid out the way ViroReact's ViroText is: a font size in points, 0.01 world units a
// point, inside a box of width x height world units centered on the node, wrapped by
// words, by characters, justified or only at newlines, aligned left, center or right and
// top, center or bottom, and clipped to the box or to a number of lines.
//
//     Font f = font_load("Inter.ttf")?;
//     SceneTextStyle st = scene_text_style();
//     st.size = 24.0;
//     st.align = SCENE_TEXT_CENTER;
//     SceneText label = scene.add_text(0, &f, "Hello, Eskiu", st)?;
//     scene.node(label.node).position = Vec3{0.0, 1.0, -2.0};
//     ...later:
//     label.set(&scene, &f, "Bye", st)?;
//
// The glyphs come from an atlas made for the text's characters, rendered at four times
// the font size, and the material is unlit (SCENE_CONSTANT) and blended: change it through
// Scene_material(text.material) like any other. style.stroke adds an outline or a drop
// shadow behind the glyphs, and style.extrusion builds solid glyphs from their outlines.

import <mem>;
import <list>;
import <result>;
import <libc>;
import <gpu>;
import <gpu/math>;
import <font/ttf>;
import <font/text>;
import <scene>;
import <scene/geometry>;
import <scene/material>;
import <scene/shapes>;

// World units per point of font size (ViroReact's kTextPointToWorldScale).
const float SCENE_TEXT_POINT = 0.01;

// Horizontal alignment (SceneTextStyle.align).
const int SCENE_TEXT_LEFT = 0;
const int SCENE_TEXT_CENTER = 1;
const int SCENE_TEXT_RIGHT = 2;

// Vertical alignment (SceneTextStyle.valign).
const int SCENE_TEXT_TOP = 0;
const int SCENE_TEXT_MIDDLE = 1;
const int SCENE_TEXT_BOTTOM = 2;

// Line breaking (SceneTextStyle.line_break): at the last space that fits, at any character,
// as WORD_WRAP with the spaces of every line but a paragraph's last stretched to the
// width, or only at newlines.
const int SCENE_TEXT_WORD_WRAP = 0;
const int SCENE_TEXT_CHAR_WRAP = 1;
const int SCENE_TEXT_JUSTIFY = 2;
const int SCENE_TEXT_NO_WRAP = 3;

// How a text is laid out. size is the font size in points; color is linear RGBA; width and
// height the box in world units, centered on the node; clip keeps the lines inside the
// box (and, without wrapping, cuts each line at its width); max_lines caps the line count
// (0 for no cap). stroke (SCENE_TEXT_STROKE_*) draws an outline or a drop shadow of
// stroke_width points in stroke_color behind the glyphs (ViroText's outerStroke); extrusion
// gives the text a depth of that many points (ViroText's extrusionDepth), the front facing
// +Z.
struct SceneTextStyle {
    float size;
    Vec4 color;
    float width;
    float height;
    int align;
    int valign;
    int line_break;
    bool clip;
    int max_lines;
    int stroke;
    float stroke_width;
    Vec4 stroke_color;
    float extrusion;
}

// The strokes of ViroText's outerStroke: none, an outline around each glyph, or a drop
// shadow down and to the right.
const int SCENE_TEXT_STROKE_NONE = 0;
const int SCENE_TEXT_STROKE_OUTLINE = 1;
const int SCENE_TEXT_STROKE_DROP_SHADOW = 2;

// ViroText's defaults: 18 points, white, a 1 x 1 box, left and top aligned, word wrap, no
// clipping, no line cap, no stroke (2 points of white when one is chosen), no extrusion.
SceneTextStyle scene_text_style() {
    return SceneTextStyle{size: 18.0, color: Vec4{1.0, 1.0, 1.0, 1.0}, width: 1.0, height: 1.0,
        align: SCENE_TEXT_LEFT, valign: SCENE_TEXT_TOP, line_break: SCENE_TEXT_WORD_WRAP, clip: false, max_lines: 0,
        stroke: SCENE_TEXT_STROKE_NONE, stroke_width: 2.0, stroke_color: Vec4{1.0, 1.0, 1.0, 1.0}, extrusion: 0.0};
}

// A text node: node draws mesh with material, whose diffuse texture is the glyph atlas
// texture. width and height are the size of the laid-out text (ViroText's realized
// size), lines its line count. The stroke and, for extruded text, the back and the sides
// are child nodes with materials of their own.
struct SceneText {
    int node;
    int mesh;
    int material;
    int texture;
    float width;
    float height;
    int lines;
    int stroke_node;
    int stroke_mesh;
    int stroke_material;
    int stroke_texture;
    int back_node;
    int back_mesh;
    int back_material;
    int side_node;
    int side_mesh;
    int side_material;
}

const int _SCENE_TEXT_OVERSAMPLE = 4;

struct _SceneTextLine {
    int start;
    int count;
    float spacing;
}

struct _SceneTextLayout {
    List<uint32> cps;
    List<_SceneTextLine> lines;
    float line_height;
    float descender;
}

bool _scene_text_ws(uint32 c) {
    return c == 32 || c == 9 || c == 11 || c == 13;
}

// The advance of character cp in world units at size points (no kerning, as ViroReact).
float _scene_text_adv(*Font f, uint32 cp, float size) {
    return (float)Font_advance(f, Font_glyph(f, cp)) * Font_scale(f, size) * SCENE_TEXT_POINT;
}

bool _scene_text_more(int lines, *SceneTextStyle st, float line_height) {
    return (st.max_lines <= 0 || lines < st.max_lines) && (!st.clip || (float)(lines + 1) * line_height < st.height);
}

void _scene_text_push(*List<_SceneTextLine> out, *List<uint32> line, *List<uint32> all, float spacing) {
    _SceneTextLine l;
    l.start = all.size;
    l.count = line.size;
    l.spacing = spacing;
    for (i in 0..line.size) List_push(all, line.data[i]);
    List_push(out, l);
    List_clear(line);
}

// Greedy word wrap of text[from, to) (ViroReact's wrapByWords). Returns false when the
// line limit stopped it.
bool _scene_text_words(*Font f, *List<uint32> text, int from, int to, *SceneTextStyle st, float lh, *_SceneTextLayout out) {
    List<uint32> line;
    float width = 0.0;
    int cur = from;
    bool more = true;
    while (cur < to) {
        if (text.data[cur] == 10) {
            _scene_text_push(&out.lines, &line, &out.cps, 1.0);
            width = 0.0;
            if (!_scene_text_more(out.lines.size, st, lh)) {
                more = false;
                break;
            }
            cur++;
            continue;
        }
        // a word: the characters to the first whitespace, then the whitespace after it,
        // stopping at a newline
        int end = cur;
        while (end < to && !_scene_text_ws(text.data[end]) && text.data[end] != 10) end++;
        while (end < to && _scene_text_ws(text.data[end])) end++;
        if (end == cur) {
            cur++;
            continue;
        }
        float ww = 0.0;
        for (k in cur..end) ww += _scene_text_adv(f, text.data[k], st.size);
        if (width + ww > st.width) {
            if (line.size == 0) {
                for (k in cur..end) List_push(&line, text.data[k]);
                _scene_text_push(&out.lines, &line, &out.cps, 1.0);
                cur = end;
            } else {
                _scene_text_push(&out.lines, &line, &out.cps, 1.0);
            }
            width = 0.0;
            if (!_scene_text_more(out.lines.size, st, lh)) {
                more = false;
                break;
            }
        } else {
            width += ww;
            for (k in cur..end) List_push(&line, text.data[k]);
            cur = end;
        }
    }
    if (more && line.size > 0 && _scene_text_more(out.lines.size, st, lh)) _scene_text_push(&out.lines, &line, &out.cps, 1.0);
    line.free();
    return more;
}


// ViroReact's Knuth-Plass formatter (VROKnuthPlassFormatter): boxes are words, glue the
// spaces between them (stretch 1/2 and shrink 1/3 of a space), a last glue of infinite
// stretch and a forced break end the paragraph.
const int _KP_INF = 10000;
const int _KP_BOX = 0;
const int _KP_GLUE = 1;
const int _KP_PENALTY = 2;

struct _KpNode {
    int kind;
    float width;
    float stretch;
    float shrink;
    int penalty;
    int flagged;
    int start;
    int count;
    bool space;
}

struct _KpSum {
    float width;
    float stretch;
    float shrink;
}

struct _KpBreak {
    int position;
    int demerits;
    float ratio;
    int line;
    int fitness;
    _KpSum totals;
    int previous;
}

float _kp_cost(_KpSum s, float length) {
    if (s.width < length) return s.stretch > 0.0 ? (length - s.width) / s.stretch : (float)_KP_INF;
    if (s.width > length) return s.shrink > 0.0 ? (length - s.width) / s.shrink : (float)_KP_INF;
    return 0.0;
}

_KpSum _kp_sum_from(*List<_KpNode> nodes, _KpSum sum, int at) {
    _KpSum r = sum;
    for (i in at..nodes.size) {
        _KpNode n = nodes.data[i];
        if (n.kind == _KP_GLUE) {
            r.width += n.width;
            r.stretch += n.stretch;
            r.shrink += n.shrink;
        } else if (n.kind == _KP_BOX) {
            break;
        } else if (n.kind == _KP_PENALTY && n.penalty == -_KP_INF && i > at) {
            break;
        }
    }
    return r;
}

void _kp_candidates(*List<_KpNode> nodes, int index, _KpSum sum, *List<_KpBreak> pool, *List<int> active, float length, float tolerance) {
    _KpNode node = nodes.data[index];
    int it = 0;
    while (it < active.size) {
        int[4] cd = {2147483647, 2147483647, 2147483647, 2147483647};
        int[4] cp;
        float[4] cr;
        while (it < active.size) {
            int bi = active.data[it];
            _KpBreak bp = pool.data[bi];
            int next = it + 1;
            int line = bp.line + 1;
            _KpSum d = _KpSum{sum.width - bp.totals.width, sum.stretch - bp.totals.stretch, sum.shrink - bp.totals.shrink};
            if (node.kind == _KP_PENALTY) d.width += node.width;
            float ratio = _kp_cost(d, length);
            if (ratio < -1.0 || (node.kind == _KP_PENALTY && node.penalty == -_KP_INF)) {
                for (k in it..active.size - 1) active.data[k] = active.data[k + 1];
                active.size--;
                next = it;
            }
            if (ratio >= -1.0 && ratio <= tolerance) {
                double r3 = (double)(ratio < 0.0 ? -ratio : ratio);
                double badness = 100.0 * r3 * r3 * r3;
                double base = (10.0 + badness) * (10.0 + badness);
                int dem = 0;
                if (node.kind == _KP_PENALTY && node.penalty >= 0) dem = (int)(base + (double)node.penalty * (double)node.penalty);
                else if (node.kind == _KP_PENALTY && node.penalty != -_KP_INF) dem = (int)(base - (double)node.penalty * (double)node.penalty);
                else dem = (int)base;
                if (node.kind == _KP_PENALTY && nodes.data[bp.position].kind == _KP_PENALTY) {
                    dem += 100 * node.flagged * nodes.data[bp.position].flagged;
                }
                int cls = 0;
                if (ratio < -0.5) cls = 0;
                else if (ratio <= 0.5) cls = 1;
                else if (ratio <= 1.0) cls = 2;
                else cls = 3;
                int gap = cls - bp.fitness;
                if (gap > 1 || gap < -1) dem += 3000;
                dem += bp.demerits;
                if (dem < cd[cls]) {
                    cd[cls] = dem;
                    cp[cls] = bi;
                    cr[cls] = ratio;
                }
            }
            it = next;
            if (it < active.size && pool.data[active.data[it]].line >= line) break;
        }
        _KpSum ns = _kp_sum_from(nodes, sum, index);
        for (c in 0..4) {
            if (cd[c] == 2147483647) continue;
            _KpBreak nb = _KpBreak{index, cd[c], cr[c], pool.data[cp[c]].line + 1, c, ns, cp[c]};
            List_push(pool, nb);
            int id = pool.size - 1;
            if (it < active.size) {
                List_push(active, 0);
                int k = active.size - 1;
                while (k > it) {
                    active.data[k] = active.data[k - 1];
                    k--;
                }
                active.data[it] = id;
                it++;
            } else {
                // inserted at the end: the position stays the end, as the list iterator does
                List_push(active, id);
                it = active.size;
            }
        }
    }
}

// The breaks of the paragraph text[from, to) at tolerance; empty when none fits.
void _kp_run(*List<_KpNode> nodes, float length, float tolerance, *List<_KpBreak> pool, *List<int> out) {
    List<int> active;
    List_clear(pool);
    _KpSum sum;
    List_push(pool, _KpBreak{0, 0, 0.0, 0, 0, sum, -1});
    List_push(&active, 0);
    for (i in 0..nodes.size) {
        _KpNode n = nodes.data[i];
        if (n.kind == _KP_BOX) {
            sum.width += n.width;
        } else if (n.kind == _KP_GLUE) {
            if (i > 0 && nodes.data[i - 1].kind == _KP_BOX) _kp_candidates(nodes, i, sum, pool, &active, length, tolerance);
            sum.width += n.width;
            sum.stretch += n.stretch;
            sum.shrink += n.shrink;
        } else if (n.penalty != _KP_INF) {
            _kp_candidates(nodes, i, sum, pool, &active, length, tolerance);
        }
    }
    List_clear(out);
    int best = -1;
    for (k in 0..active.size) {
        int b = active.data[k];
        if (best < 0 || pool.data[b].demerits < pool.data[best].demerits) best = b;
    }
    List<int> rev;
    while (best >= 0) {
        List_push(&rev, best);
        best = pool.data[best].previous;
    }
    for (k in 0..rev.size) List_push(out, rev.data[rev.size - 1 - k]);
    rev.free();
    active.free();
}

// Justifies the paragraph text[from, to) as ViroReact does; false when no tolerance from 2
// to 4 finds breaks. Each line keeps the space it was broken at, counted when its spaces
// are stretched, as ViroReact's.
bool _scene_text_kp(*Font f, *List<uint32> text, int from, int to, *SceneTextStyle st, *_SceneTextLayout out) {
    float space = _scene_text_adv(f, 32, st.size);
    List<_KpNode> nodes;
    defer nodes.free();
    int i = from;
    while (i < to) {
        while (i < to && _scene_text_ws(text.data[i])) i++;
        if (i >= to) break;
        int s = i;
        float w = 0.0;
        while (i < to && !_scene_text_ws(text.data[i])) {
            w += _scene_text_adv(f, text.data[i], st.size);
            i++;
        }
        List_push(&nodes, _KpNode{kind: _KP_BOX, width: w, start: s, count: i - s});
        List_push(&nodes, _KpNode{kind: _KP_GLUE, width: space, stretch: space * 3.0 / 6.0, shrink: space * 3.0 / 9.0, space: true});
    }
    if (nodes.size == 0) return false;
    // the last word's glue: infinite stretch, then the forced break
    nodes.data[nodes.size - 1] = _KpNode{kind: _KP_GLUE, width: 0.0, stretch: (float)_KP_INF, shrink: 0.0};
    List_push(&nodes, _KpNode{kind: _KP_PENALTY, width: 0.0, penalty: -_KP_INF, flagged: 1});
    List<_KpBreak> pool;
    defer pool.free();
    List<int> breaks;
    defer breaks.free();
    for (tol in 2..5) {
        _kp_run(&nodes, st.width, (float)tol, &pool, &breaks);
        if (breaks.size > 0) break;
    }
    if (breaks.size == 0) return false;
    int line_start = 0;
    List<uint32> line;
    defer line.free();
    for (b in 1..breaks.size) {
        int point = pool.data[breaks.data[b]].position;
        for (j in line_start..nodes.size) {
            if (nodes.data[j].kind == _KP_BOX || (nodes.data[j].kind == _KP_PENALTY && nodes.data[j].penalty == -_KP_INF)) {
                line_start = j;
                break;
            }
        }
        int spaces = 0;
        float width = 0.0;
        for (j in line_start..point + 1) {
            _KpNode n = nodes.data[j];
            if (n.kind == _KP_BOX) {
                for (k in 0..n.count) List_push(&line, text.data[n.start + k]);
                width += n.width;
            } else if (n.space) {
                List_push(&line, 32);
                width += space;
                spaces++;
            }
        }
        float ratio = 1.0;
        if (b < breaks.size - 1 && spaces > 0 && space > 0.0) ratio = 1.0 + (st.width - width) / (float)spaces / space;
        _scene_text_push(&out.lines, &line, &out.cps, ratio);
        line_start = point;
    }
    return true;
}

void _scene_text_layout(*Font f, *List<uint32> text, *SceneTextStyle st, *_SceneTextLayout out) {
    float lh = Font_line_height(f, st.size) * SCENE_TEXT_POINT;
    out.line_height = lh;
    out.descender = -(float)f.descent * Font_scale(f, st.size) * SCENE_TEXT_POINT;
    List<uint32> line;
    if (st.line_break == SCENE_TEXT_WORD_WRAP) {
        _scene_text_words(f, text, 0, text.size, st, lh, out);
    } else if (st.line_break == SCENE_TEXT_CHAR_WRAP) {
        float width = 0.0;
        int i = 0;
        while (i < text.size) {
            uint32 c = text.data[i];
            float cw = _scene_text_adv(f, c, st.size);
            if (width + cw > st.width || c == 10) {
                _scene_text_push(&out.lines, &line, &out.cps, 1.0);
                if (!_scene_text_more(out.lines.size, st, lh)) break;
                width = 0.0;
                if (c == 10) i++;
                else if (line.size == 0 && cw > st.width) {
                    // a character wider than the box gets a line of its own
                    List_push(&line, c);
                    width = cw;
                    i++;
                }
                continue;
            }
            width += cw;
            List_push(&line, c);
            i++;
        }
        if (line.size > 0 && _scene_text_more(out.lines.size, st, lh)) _scene_text_push(&out.lines, &line, &out.cps, 1.0);
    } else if (st.line_break == SCENE_TEXT_NO_WRAP) {
        float width = 0.0;
        for (i in 0..text.size) {
            uint32 c = text.data[i];
            float cw = _scene_text_adv(f, c, st.size);
            if (c == 10) {
                _scene_text_push(&out.lines, &line, &out.cps, 1.0);
                if (!_scene_text_more(out.lines.size, st, lh)) break;
                width = 0.0;
            } else if (!st.clip || width + cw < st.width) {
                width += cw;
                List_push(&line, c);
            }
        }
        if (line.size > 0 && _scene_text_more(out.lines.size, st, lh)) _scene_text_push(&out.lines, &line, &out.cps, 1.0);
    } else {
        // justify: each paragraph broken by ViroReact's Knuth-Plass formatter (greedy word
        // wrap when no tolerance fits), the spaces of every line but the paragraph's last
        // stretched to the box width
        int start = 0;
        while (start <= text.size) {
            int end = start;
            while (end < text.size && text.data[end] != 10) end++;
            if (end == start) {
                List<uint32> empty;
                _scene_text_push(&out.lines, &empty, &out.cps, 1.0);
                empty.free();
            } else if (!_scene_text_kp(f, text, start, end, st, out)) {
                _scene_text_words(f, text, start, end, st, lh, out);
            }
            if (end >= text.size) break;
            start = end + 1;
        }
        int keep = out.lines.size;
        if (st.clip && lh > 0.0) {
            int by_clip = (int)floorf(st.height / lh);
            if (by_clip < keep) keep = by_clip;
        }
        if (st.max_lines > 0 && st.max_lines < keep) keep = st.max_lines;
        while (out.lines.size > keep) List_pop(&out.lines);
    }
    line.free();
}

void _scene_text_free_layout(*_SceneTextLayout l) {
    l.cps.free();
    l.lines.free();
}

import "_text/mesh.esk";
