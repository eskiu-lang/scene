// material.esk: materials and the shaders made for them (`<scene/material>`).
//
// A SceneMaterial picks a lighting model, its colors and textures, how alpha
// is used and how a transparent surface blends with what is behind it.
// Start from scene_material, which fills in the defaults:
//
//     SceneMaterial m = scene_material(SCENE_PBR);
//     m.diffuse = Vec4{0.8, 0.1, 0.1, 1.0};
//     m.roughness = 0.4;
//     int red = scene.add_material(m);
//
// Colors are linear RGB (not sRGB) and may go above 1 for HDR. Texture fields
// hold ids from Scene_add_texture and friends; 0 is no texture.
//
// The renderer makes one WGSL shader and pipeline per variant (lighting
// model, alpha mode, blend mode, sidedness) and keeps it for every material
// that shares the variant; scene_material_key and scene_material_shader are the
// pieces it uses.

import <string>;
import <gpu/math>;
import <list>;
import <libc>;
import <scene/glsl>;

// Lighting models (SceneMaterial.lighting). CONSTANT shows the diffuse color unlit;
// LAMBERT is diffuse light only; PHONG and BLINN add a specular highlight (around the
// reflection of the light, or around the half vector); PBR is the metallic-roughness
// model (GGX, Smith visibility, Fresnel-Schlick) with image-based ambient light when the
// scene has an environment.
const int SCENE_CONSTANT = 0;
const int SCENE_LAMBERT = 1;
const int SCENE_PHONG = 2;
const int SCENE_BLINN = 3;
const int SCENE_PBR = 4;

// Alpha modes (SceneMaterial.alpha_mode): the surface is opaque (alpha ignored), cut out
// where alpha is below alpha_cutoff, or blended with what is behind it (drawn after the
// opaque surfaces, back to front).
const int SCENE_ALPHA_OPAQUE = 0;
const int SCENE_ALPHA_MASK = 1;
const int SCENE_ALPHA_BLEND = 2;

// Blend modes of a SCENE_ALPHA_BLEND material (SceneMaterial.blend_mode), with s the
// surface color, a its alpha and d the color behind it: ALPHA is s * a + d * (1 - a);
// ADD is d + s * a; MULTIPLY is d * mix(1, s, a); SUBTRACT is d - s * a; SCREEN is
// d + s * a * (1 - d); PREMULTIPLIED is s + d * (1 - a), for colors already multiplied
// by their alpha.
const int SCENE_BLEND_ALPHA = 0;
const int SCENE_BLEND_ADD = 1;
const int SCENE_BLEND_MULTIPLY = 2;
const int SCENE_BLEND_SUBTRACT = 3;
const int SCENE_BLEND_SCREEN = 4;
const int SCENE_BLEND_PREMULTIPLIED = 5;

// How a texture of a material reads its coordinates: set picks the vertex's first (0) or
// second (1) texture coordinate; with transform (glTF's KHR_texture_transform) they are
// scaled by scale, turned by rotation (radians) and moved by offset first.
struct SceneUv {
    int set;
    bool transform;
    Vec2 offset;
    float rotation;
    Vec2 scale;
}

// The texture slots of SceneMaterial.uv.
const int SCENE_TEX_DIFFUSE = 0;
const int SCENE_TEX_SPECULAR = 1;
const int SCENE_TEX_NORMAL = 2;
const int SCENE_TEX_EMISSIVE = 3;
const int SCENE_TEX_METAL_ROUGH = 4;
const int SCENE_TEX_OCCLUSION = 5;

// A material. Fields by lighting model:
// - every model: diffuse (linear RGBA, multiplied by diffuse_texture and the vertex
//   color), emissive (added after lighting, times emissive_texture), alpha_mode,
//   alpha_cutoff, blend_mode, double_sided, normal_texture (tangent-space normal map,
//   strength normal_scale; not used by CONSTANT).
// - LAMBERT, PHONG, BLINN: diffuse_intensity scales the lit diffuse term; PHONG and BLINN
//   add specular (times specular_texture) with exponent shininess.
// - PBR: metalness and roughness (times the blue and green channels of
//   metal_rough_texture, as glTF stores them) and occlusion_texture (red channel,
//   strength occlusion_strength) on the ambient term.
// Texture ids come from the Scene that draws the material (0 is none). uv holds how each
// texture reads its coordinates, in the order diffuse, specular, normal, emissive,
// metal-roughness, occlusion (SCENE_TEX_DIFFUSE and the others). shader is a program of
// shader modifiers from Scene_add_shader (0 for none), ViroReact's shaderModifiers.
struct SceneMaterial {
    int lighting;
    Vec4 diffuse;
    int diffuse_texture;
    float diffuse_intensity;
    Vec3 specular;
    float shininess;
    int specular_texture;
    int normal_texture;
    float normal_scale;
    Vec3 emissive;
    int emissive_texture;
    float metalness;
    float roughness;
    int metal_rough_texture;
    int occlusion_texture;
    float occlusion_strength;
    int alpha_mode;
    float alpha_cutoff;
    int blend_mode;
    bool double_sided;
    bool skip_depth_test;
    bool skip_depth_write;
    int wrap_s;
    int wrap_t;
    int filter;
    int mip_filter;
    SceneUv[6] uv;
    int shader;
}

// How the material's textures repeat past 0..1 (SceneMaterial.wrap_s, wrap_t; ViroReact's
// wrapS and wrapT): repeated, the edge texels stretched, or mirrored.
const int SCENE_WRAP_REPEAT = 0;
const int SCENE_WRAP_CLAMP = 1;
const int SCENE_WRAP_MIRROR = 2;

// How texels are filtered (SceneMaterial.filter, for magnification and minification
// alike, and mip_filter between mipmap levels; ViroReact's magnificationFilter,
// minificationFilter and mipFilter).
const int SCENE_FILTER_LINEAR = 0;
const int SCENE_FILTER_NEAREST = 1;

// A material of lighting model lighting with the defaults: white diffuse at intensity 1,
// white specular with shininess 32, no emission, metalness 0, roughness 0.5, normal scale
// and occlusion strength 1, opaque, alpha cutoff 0.5, ALPHA blending, one-sided.
SceneMaterial scene_material(int lighting) {
    return SceneMaterial{lighting: lighting, diffuse: Vec4{1.0, 1.0, 1.0, 1.0}, diffuse_intensity: 1.0,
        specular: Vec3{1.0, 1.0, 1.0}, shininess: 32.0, normal_scale: 1.0, roughness: 0.5,
        occlusion_strength: 1.0, alpha_cutoff: 0.5, blend_mode: SCENE_BLEND_ALPHA};
}

// The multiple of a key that holds the material's shader program (scene_key_shader).
const int SCENE_KEY_SHADER = 16384;

// The shader variant of a material: the lighting model, the alpha mode, the blend mode
// (only for blended materials) and the sidedness, packed in one int. Materials with the
// same key share a pipeline.
int scene_material_key(*SceneMaterial m) {
    int lighting = m.lighting < 0 || m.lighting > SCENE_PBR ? SCENE_BLINN : m.lighting;
    int alpha = m.alpha_mode < 0 || m.alpha_mode > SCENE_ALPHA_BLEND ? SCENE_ALPHA_OPAQUE : m.alpha_mode;
    int blend = 0;
    if (alpha == SCENE_ALPHA_BLEND) {
        blend = m.blend_mode < 0 || m.blend_mode > SCENE_BLEND_PREMULTIPLIED ? SCENE_BLEND_ALPHA : m.blend_mode;
    }
    return lighting + alpha * 8 + blend * 32 + (m.double_sided ? 256 : 0) + (m.skip_depth_test ? 1024 : 0) +
        (m.skip_depth_write ? 2048 : 0) + (m.shader > 0 ? m.shader * SCENE_KEY_SHADER : 0);
}

// The shader program of a material key (0 for none).
int scene_key_shader(int key) {
    return key / SCENE_KEY_SHADER;
}

// The lighting model of a material key.
int scene_key_lighting(int key) {
    return key % 8;
}

// The alpha mode of a material key.
int scene_key_alpha(int key) {
    return (key / 8) % 4;
}

// The blend mode of a material key (SCENE_BLEND_ALPHA unless the alpha mode is BLEND).
int scene_key_blend(int key) {
    return (key / 32) % 8;
}

// Whether a material key is double-sided.
bool scene_key_double_sided(int key) {
    return (key / 256) % 2 == 1;
}

// The key of a material drawn on a node faded by its opacity (SceneNode.opacity below 1):
// blended over what is behind it with its alpha times the node's opacity, whatever the
// material's own alpha mode.
int scene_key_fade(int key) {
    return scene_key_faded(key) ? key : key + 512;
}

// Whether a key draws over everything before it (SceneMaterial.skip_depth_test).
bool scene_key_skips_depth_test(int key) {
    return (key / 1024) % 2 == 1;
}

// Whether a key leaves the depth buffer as it is (SceneMaterial.skip_depth_write; blended
// keys never write depth).
bool scene_key_skips_depth_write(int key) {
    return (key / 2048) % 2 == 1 || scene_key_blended(key);
}

// Whether a key is faded (scene_key_fade).
bool scene_key_faded(int key) {
    return (key / 512) % 2 == 1;
}

// Whether a key draws blended: a BLEND material, or a faded one.
bool scene_key_blended(int key) {
    return scene_key_alpha(key) == SCENE_ALPHA_BLEND || scene_key_faded(key);
}

// Morph targets and skinning, shared by the scene and shadow vertex shaders: draw.morph is
// (vertex count, target count); morph holds two vec4s per target and vertex (position and
// normal deltas, at (t * count + v) * 2); draw.info.z > 0.5 skins with joints.
#define SCENE_DEFORM_WGSL \
    "fn morph_apply(vi: u32, p: ptr<function, vec3<f32>>, n: ptr<function, vec3<f32>>) {\n" \
    "    let count = u32(draw.morph.x);\n" \
    "    let targets = u32(draw.morph.y);\n" \
    "    for (var t = 0u; t < targets; t++) {\n" \
    "        let w = weights[t];\n" \
    "        if (w == 0.0) { continue; }\n" \
    "        let at = (t * count + vi) * 2u;\n" \
    "        *p = *p + morph[at].xyz * w;\n" \
    "        *n = *n + morph[at + 1u].xyz * w;\n" \
    "    }\n" \
    "}\n" \
    "fn skin_matrix(j: vec4<f32>, w: vec4<f32>) -> mat4x4<f32> {\n" \
    "    if (draw.info.z < 0.5) { return mat4x4<f32>(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0),\n" \
    "        vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0)); }\n" \
    "    return joints[u32(j.x)] * w.x + joints[u32(j.y)] * w.y + joints[u32(j.z)] * w.z + joints[u32(j.w)] * w.w;\n" \
    "}\n"

string _scene_common_wgsl =
    "struct Frame { view_proj: mat4x4<f32>, eye: vec4<f32>, forward: vec4<f32>, ambient: vec4<f32>,\n"
    "    ibl: vec4<f32>, shadow: vec4<f32>, view: mat4x4<f32>, proj: mat4x4<f32> };\n"
    "struct Light { color: vec4<f32>, position: vec4<f32>, direction: vec4<f32>, atten: vec4<f32>,\n"
    "    spot: vec4<f32>, shadow_vp: mat4x4<f32> };\n"
    "struct Draw { model: mat4x4<f32>, normal: mat4x4<f32>, lights: array<vec4<u32>, 2>, info: vec4<f32>, morph: vec4<f32> };\n"
    "struct Material { diffuse: vec4<f32>, specular: vec4<f32>, emissive: vec4<f32>, pbr: vec4<f32>, extra: vec4<f32>,\n"
    "    tf: array<vec4<f32>, 12> };\n"
    "@group(0) @binding(0) var<uniform> frame: Frame;\n"
    "@group(0) @binding(1) var<storage, read> lights: array<Light>;\n"
    "@group(0) @binding(2) var shadow_maps: texture_depth_2d_array;\n"
    "@group(0) @binding(3) var shadow_samp: sampler_comparison;\n"
    "@group(0) @binding(4) var irr_tex: texture_cube<f32>;\n"
    "@group(0) @binding(5) var spec_tex: texture_cube<f32>;\n"
    "@group(0) @binding(6) var brdf_tex: texture_2d<f32>;\n"
    "@group(0) @binding(7) var ibl_samp: sampler;\n"
    "@group(1) @binding(0) var<uniform> draw: Draw;\n"
    "@group(1) @binding(1) var<storage, read> joints: array<mat4x4<f32>>;\n"
    "@group(1) @binding(2) var<storage, read> morph: array<vec4<f32>>;\n"
    "@group(1) @binding(3) var<storage, read> weights: array<f32>;\n"
    "@group(2) @binding(0) var<uniform> mat: Material;\n"
    "@group(2) @binding(1) var mat_samp: sampler;\n"
    "@group(2) @binding(2) var diffuse_tex: texture_2d<f32>;\n"
    "@group(2) @binding(3) var specular_tex: texture_2d<f32>;\n"
    "@group(2) @binding(4) var normal_tex: texture_2d<f32>;\n"
    "@group(2) @binding(5) var emissive_tex: texture_2d<f32>;\n"
    "@group(2) @binding(6) var mr_tex: texture_2d<f32>;\n"
    "@group(2) @binding(7) var occ_tex: texture_2d<f32>;\n"
    "struct In { @builtin(vertex_index) vi: u32, @location(0) pos: vec3<f32>, @location(1) normal: vec3<f32>,\n"
    "    @location(2) uv: vec2<f32>, @location(3) tangent: vec4<f32>, @location(4) color: vec4<f32>,\n"
    "    @location(5) uv1: vec2<f32>, @location(6) joint: vec4<f32>, @location(7) weight: vec4<f32> };\n"
    "struct V { @builtin(position) clip: vec4<f32>, @location(0) world: vec3<f32>, @location(1) normal: vec3<f32>,\n"
    "    @location(2) uv: vec2<f32>, @location(3) tangent: vec4<f32>, @location(4) color: vec4<f32>,\n"
    "    @location(5) uv1: vec2<f32> };\n"
    SCENE_DEFORM_WGSL
    "@vertex fn vs(v: In) -> V {\n"
    "    var p = v.pos;\n"
    "    var nrm = v.normal;\n"
    "    morph_apply(v.vi, &p, &nrm);\n"
    "    let sk = skin_matrix(v.joint, v.weight);\n"
    "    let world = draw.model * (sk * vec4<f32>(p, 1.0));\n"
    "    var o: V;\n"
    "    o.clip = frame.view_proj * world;\n"
    "    o.world = world.xyz;\n"
    "    let s3 = mat3x3<f32>(sk[0].xyz, sk[1].xyz, sk[2].xyz);\n"
    "    let nm = mat3x3<f32>(draw.normal[0].xyz, draw.normal[1].xyz, draw.normal[2].xyz);\n"
    "    o.normal = nm * (s3 * nrm);\n"
    "    let mm = mat3x3<f32>(draw.model[0].xyz, draw.model[1].xyz, draw.model[2].xyz);\n"
    "    o.tangent = vec4<f32>(mm * (s3 * v.tangent.xyz), v.tangent.w);\n"
    "    o.uv = v.uv;\n"
    "    o.uv1 = v.uv1;\n"
    "    o.color = v.color;\n"
    "    return o;\n"
    "}\n"
    "fn tuv(v: V, k: u32) -> vec2<f32> {\n"
    "    let m = mat.tf[k * 2u];\n"
    "    let o = mat.tf[k * 2u + 1u];\n"
    "    let uv = select(v.uv, v.uv1, o.z > 0.5);\n"
    "    return vec2<f32>(m.x * uv.x + m.y * uv.y + o.x, m.z * uv.x + m.w * uv.y + o.y);\n"
    "}\n"
    "const PI = 3.14159265358979;\n"
    "fn draw_light(k: u32) -> u32 { return draw.lights[k / 4u][k % 4u]; }\n"
    "fn light_at(i: u32, pos: vec3<f32>) -> vec4<f32> {\n"
    "    let li = lights[i];\n"
    "    if (li.position.w < 1.5) { return vec4<f32>(-li.direction.xyz, 1.0); }\n"
    "    let to = li.position.xyz - pos;\n"
    "    let dist = length(to);\n"
    "    let l = to / max(dist, 1e-6);\n"
    "    let d = clamp((dist - li.atten.x) / max(li.atten.y - li.atten.x, 1e-4), 0.0, 1.0);\n"
    "    var att = 1.0 - select(pow(d, 1.0 / max(li.atten.z, 1e-3)), 0.0, d <= 0.0);\n"
    "    if (li.position.w > 2.5) {\n"
    "        let theta = dot(l, -li.direction.xyz);\n"
    "        att = att * clamp((theta - li.spot.y) / max(li.spot.x - li.spot.y, 1e-4), 0.0, 1.0);\n"
    "    }\n"
    "    return vec4<f32>(l, att);\n"
    "}\n"
    "fn shadow_at(i: u32, world: vec3<f32>, n: vec3<f32>) -> f32 {\n"
    "    let li = lights[i];\n"
    "    if (li.direction.w < 0.0 || draw.info.y < 0.5) { return 1.0; }\n"
    "    let p = li.shadow_vp * vec4<f32>(world + n * li.spot.w, 1.0);\n"
    "    if (p.w <= 0.0) { return 1.0; }\n"
    "    let c = p.xyz / p.w;\n"
    "    let uv = vec2<f32>(c.x * 0.5 + 0.5, 0.5 - c.y * 0.5);\n"
    "    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || c.z > 1.0) { return 1.0; }\n"
    "    let layer = i32(li.direction.w + 0.5);\n"
    "    let ref_d = c.z - li.atten.w;\n"
    "    var lit = 0.0;\n"
    "    for (var y = -1; y <= 1; y++) {\n"
    "        for (var x = -1; x <= 1; x++) {\n"
    "            lit += textureSampleCompareLevel(shadow_maps, shadow_samp, uv + vec2<f32>(f32(x), f32(y)) * frame.shadow.x, layer, ref_d);\n"
    "        }\n"
    "    }\n"
    "    return mix(1.0, lit / 9.0, li.spot.z);\n"
    "}\n"
    "struct Surf { base: vec4<f32>, n: vec3<f32>, geo_n: vec3<f32>, v: vec3<f32>, pos: vec3<f32>, spec: vec3<f32>,\n"
    "    shininess: f32, metal: f32, rough: f32, ao: f32 };\n";

string _scene_constant_wgsl =
    "fn shade(s: Surf) -> vec3<f32> { return s.base.rgb; }\n";

string _scene_classic_head =
    "fn shade(s: Surf) -> vec3<f32> {\n"
    "    var diff = vec3<f32>(0.0);\n"
    "    var spec = vec3<f32>(0.0);\n"
    "    let count = u32(draw.info.x);\n"
    "    for (var k = 0u; k < count; k++) {\n"
    "        let i = draw_light(k);\n"
    "        let la = light_at(i, s.pos);\n"
    "        let l = la.xyz;\n"
    "        let radiance = lights[i].color.rgb * lights[i].color.w * la.w * shadow_at(i, s.pos, s.geo_n);\n"
    "        let nl = max(dot(s.n, l), 0.0);\n"
    "        diff += radiance * nl;\n";

string _scene_phong_spec =
    "        if (nl > 0.0) { spec += radiance * pow(max(dot(s.v, reflect(-l, s.n)), 0.0), s.shininess); }\n";

string _scene_blinn_spec =
    "        if (nl > 0.0) { spec += radiance * pow(max(dot(normalize(s.v + l), s.n), 0.0), s.shininess); }\n";

string _scene_classic_tail =
    "    }\n"
    "    return frame.ambient.rgb * s.base.rgb + diff * s.base.rgb * mat.extra.x + spec * s.spec;\n"
    "}\n";

string _scene_pbr_wgsl =
    "fn shade(s: Surf) -> vec3<f32> {\n"
    "    let a = s.rough * s.rough;\n"
    "    let a2 = a * a;\n"
    "    let f0 = mix(vec3<f32>(0.04), s.base.rgb, s.metal);\n"
    "    let nv = max(dot(s.n, s.v), 1e-4);\n"
    "    var color = vec3<f32>(0.0);\n"
    "    let count = u32(draw.info.x);\n"
    "    for (var k = 0u; k < count; k++) {\n"
    "        let i = draw_light(k);\n"
    "        let la = light_at(i, s.pos);\n"
    "        let l = la.xyz;\n"
    "        let radiance = lights[i].color.rgb * lights[i].color.w * la.w * shadow_at(i, s.pos, s.geo_n);\n"
    "        let h = normalize(s.v + l);\n"
    "        let nl = max(dot(s.n, l), 0.0);\n"
    "        let nh = max(dot(s.n, h), 0.0);\n"
    "        let vh = max(dot(s.v, h), 0.0);\n"
    "        let f = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);\n"
    "        let dn = nh * nh * (a2 - 1.0) + 1.0;\n"
    "        let d = a2 / (PI * dn * dn);\n"
    "        let gv = nl * sqrt(nv * nv * (1.0 - a2) + a2);\n"
    "        let gl = nv * sqrt(nl * nl * (1.0 - a2) + a2);\n"
    "        let vis = 0.5 / max(gv + gl, 1e-5);\n"
    "        let kd = (1.0 - f) * (1.0 - s.metal);\n"
    "        color += (kd * s.base.rgb / PI + f * d * vis) * radiance * nl * PI;\n"
    "    }\n"
    "    if (frame.ibl.x > 0.5) {\n"
    "        let fa = f0 + (max(vec3<f32>(1.0 - s.rough), f0) - f0) * pow(1.0 - nv, 5.0);\n"
    "        let irr = textureSampleLevel(irr_tex, ibl_samp, s.n, 0.0).rgb;\n"
    "        let pre = textureSampleLevel(spec_tex, ibl_samp, reflect(-s.v, s.n), s.rough * frame.ibl.z).rgb;\n"
    "        let ab = textureSampleLevel(brdf_tex, ibl_samp, vec2<f32>(nv, s.rough), 0.0).rg;\n"
    "        color += (irr * s.base.rgb * (1.0 - s.metal) * (1.0 - fa) + pre * (f0 * ab.x + ab.y)) * s.ao * frame.ibl.y;\n"
    "    } else {\n"
    "        color += frame.ambient.rgb * s.base.rgb * s.ao;\n"
    "    }\n"
    "    return color;\n"
    "}\n";

string _scene_fs_head =
    "@fragment fn fs(v: V, @builtin(front_facing) front: bool) -> @location(0) vec4<f32> {\n"
    "    let d_s = textureSample(diffuse_tex, mat_samp, tuv(v, 0u));\n"
    "    let s_s = textureSample(specular_tex, mat_samp, tuv(v, 1u));\n"
    "    let nuv = tuv(v, 2u);\n"
    "    let n_s = textureSample(normal_tex, mat_samp, nuv).xyz;\n"
    "    let e_s = textureSample(emissive_tex, mat_samp, tuv(v, 3u)).rgb;\n"
    "    let mr_s = textureSample(mr_tex, mat_samp, tuv(v, 4u));\n"
    "    let o_s = textureSample(occ_tex, mat_samp, tuv(v, 5u)).r;\n"
    "    let dp1 = dpdx(v.world);\n"
    "    let dp2 = dpdy(v.world);\n"
    "    let duv1 = dpdx(nuv);\n"
    "    let duv2 = dpdy(nuv);\n"
    "    var n = normalize(v.normal);\n"
    "    if (!front) { n = -n; }\n"
    "    var s: Surf;\n"
    "    s.geo_n = n;\n"
    "    if (mat.pbr.z > 0.0) {\n"
    "        var t = cross(dp2, n) * duv1.x + cross(n, dp1) * duv2.x;\n"
    "        var b = cross(dp2, n) * duv1.y + cross(n, dp1) * duv2.y;\n"
    "        let inv = inverseSqrt(max(max(dot(t, t), dot(b, b)), 1e-20));\n"
    "        t = t * inv;\n"
    "        b = b * inv;\n"
    "        if (abs(v.tangent.w) > 0.5) {\n"
    "            t = normalize(v.tangent.xyz - n * dot(n, v.tangent.xyz));\n"
    "            b = cross(n, t) * v.tangent.w;\n"
    "        }\n"
    "        let tn = (n_s * 2.0 - 1.0) * vec3<f32>(mat.pbr.z, mat.pbr.z, 1.0);\n"
    "        n = normalize(t * tn.x + b * tn.y + n * tn.z);\n"
    "    }\n"
    "    s.base = mat.diffuse * v.color * d_s;\n"
    "    s.n = n;\n"
    "    s.pos = v.world;\n"
    "    s.v = select(normalize(frame.eye.xyz - v.world), -frame.forward.xyz, frame.eye.w > 0.5);\n"
    "    s.spec = mat.specular.rgb * s_s.rgb;\n"
    "    s.shininess = mat.specular.w;\n"
    "    s.metal = clamp(mat.pbr.x * mr_s.b, 0.0, 1.0);\n"
    "    s.rough = clamp(mat.pbr.y * mr_s.g, 0.04, 1.0);\n"
    "    s.ao = 1.0 + mat.pbr.w * (o_s - 1.0);\n";

// The WGSL shader of a material key (scene_material_key): the vertex stage vs and the
// fragment stage fs, over the bind groups the renderer sets (0: frame, lights, shadow
// maps and environment; 1: the node; 2: the material). The text is appended to out.
void scene_material_shader(int key, *String out) {
    scene_material_shader_with(key, null, out);
}

// scene_material_shader with the shader modifiers of prog (null for none) inserted where
// ViroReact inserts them.
void scene_material_shader_with(int key, *SceneShader prog, *String out) {
    if (prog != null && prog.modifiers.size > 0) {
        _scene_modified_shader(key, prog, out);
        return;
    }
    int lighting = scene_key_lighting(key);
    int alpha = scene_key_alpha(key);
    int blend = scene_key_blend(key);
    String_append(out, _scene_common_wgsl);
    if (lighting == SCENE_CONSTANT) {
        String_append(out, _scene_constant_wgsl);
    } else if (lighting == SCENE_PBR) {
        String_append(out, _scene_pbr_wgsl);
    } else {
        String_append(out, _scene_classic_head);
        if (lighting == SCENE_PHONG) String_append(out, _scene_phong_spec);
        if (lighting == SCENE_BLINN) String_append(out, _scene_blinn_spec);
        String_append(out, _scene_classic_tail);
    }
    String_append(out, _scene_fs_head);
    if (alpha == SCENE_ALPHA_MASK) String_append(out, "    if (s.base.a < mat.emissive.w) { discard; }\n");
    String_append(out, "    var color = shade(s) + mat.emissive.rgb * e_s;\n");
    if (!scene_key_blended(key)) {
        String_append(out, "    return vec4<f32>(color, 1.0);\n}\n");
        return;
    }
    if (alpha == SCENE_ALPHA_BLEND) {
        String_append(out, "    let alpha = clamp(s.base.a * draw.info.w, 0.0, 1.0);\n");
    } else {
        String_append(out, "    let alpha = clamp(draw.info.w, 0.0, 1.0);\n");
    }
    if (blend == SCENE_BLEND_MULTIPLY) String_append(out, "    color = mix(vec3<f32>(1.0), color, alpha);\n");
    if (blend == SCENE_BLEND_SCREEN) String_append(out, "    color = clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)) * alpha;\n");
    String_append(out, "    return vec4<f32>(color, alpha);\n}\n");
}

// --- shader modifiers ---

// Where a shader modifier's code runs (ViroReact's VROShaderEntryPoint):
// - GEOMETRY: in the vertex stage before the transforms, reading and writing _geometry
//   (position, normal, texcoord, tangent, bone_weights, bone_indices, in the node's space)
//   and _transforms (model_matrix, view_matrix, projection_matrix).
// - VERTEX: after them, on _vertex.position (clip space).
// - SURFACE: in the fragment stage before lighting, on _surface (diffuse_color,
//   diffuse_texcoord, diffuse_intensity, shininess, specular_color, specular_texcoord,
//   roughness, roughness_intensity, metalness, metalness_intensity, ao, alpha, normal,
//   position, view).
// - LIGHTING: once per light, after the material's own lighting model filled
//   _lightingContribution (ambient, diffuse, specular, visibility) from _light (type,
//   attenuation_start_distance, attenuation_end_distance, attenuation_falloff_exp,
//   position, direction, color, intensity, spot_inner_angle, spot_outer_angle).
// - FRAGMENT: last, on _output_color.
const int SCENE_MODIFIER_GEOMETRY = 0;
const int SCENE_MODIFIER_VERTEX = 1;
const int SCENE_MODIFIER_SURFACE = 2;
const int SCENE_MODIFIER_LIGHTING = 3;
const int SCENE_MODIFIER_FRAGMENT = 4;

// One shader modifier: its entry point (SCENE_MODIFIER_*), uniform declarations, body and
// varyings (values the vertex stage passes to the fragment stage), in GLSL as ViroReact's
// (uniforms "uniform float time;", varyings "highp float lift") or, with wgsl, in WGSL
// (uniforms "time: f32;", a texture "tex: texture_2d<f32>;").
struct SceneShaderModifier {
    int entry;
    string uniforms;
    string body;
    string varyings;
    bool wgsl;
}

// A GLSL modifier, as ViroReact's shaderModifiers take them.
SceneShaderModifier scene_modifier(int entry, string uniforms, string body) {
    return SceneShaderModifier{entry: entry, uniforms: uniforms, body: body, varyings: "", wgsl: false};
}

// A WGSL modifier: the same entry points and names, the body in WGSL.
SceneShaderModifier scene_modifier_wgsl(int entry, string uniforms, string body) {
    return SceneShaderModifier{entry: entry, uniforms: uniforms, body: body, varyings: "", wgsl: true};
}

// A shader program: modifiers with their uniforms and varyings gathered and their bodies in
// WGSL. offsets holds each uniform's byte offset in the material's uniform block (-1 for a
// texture), uniform_bytes its size.
struct SceneShader {
    List<SceneShaderModifier> modifiers;
    List<GlslDecl> uniforms;
    List<int> offsets;
    List<GlslDecl> varyings;
    String[5] bodies;
    int uniform_bytes;
    int textures;
}

int _scene_uniform_size(string t) {
    if (strcmp(t, "mat4") == 0) return 64;
    if (strcmp(t, "mat3") == 0) return 48;
    return 16;
}

bool _scene_has_decl(*List<GlslDecl> l, string name) {
    for (i in 0..l.size) {
        if (strcmp((string)l.data[i].name.data, name) == 0) return true;
    }
    return false;
}

// Gathers modifiers into a program: their declarations read, GLSL bodies translated.
Result<SceneShader, string> scene_shader(*List<SceneShaderModifier> modifiers) {
    SceneShader p;
    String err;
    for (i in 0..modifiers.size) {
        SceneShaderModifier m = modifiers.data[i];
        if (m.entry < 0 || m.entry > SCENE_MODIFIER_FRAGMENT) {
            scene_shader_free(&p);
            return Err<SceneShader, string>("modifier: unknown entry point");
        }
        List_push(&p.modifiers, m);
        List<GlslDecl> us;
        List<GlslDecl> vs;
        bool ok = glsl_declarations(m.uniforms, &us, &err) && glsl_declarations(m.varyings, &vs, &err);
        for (k in 0..us.size) {
            if (_scene_has_decl(&p.uniforms, (string)us.data[k].name.data)) {
                us.data[k].name.free();
                us.data[k].type.free();
                continue;
            }
            List_push(&p.uniforms, us.data[k]);
        }
        for (k in 0..vs.size) {
            if (_scene_has_decl(&p.varyings, (string)vs.data[k].name.data)) {
                vs.data[k].name.free();
                vs.data[k].type.free();
                continue;
            }
            List_push(&p.varyings, vs.data[k]);
        }
        us.free();
        vs.free();
        if (!ok) {
            scene_shader_free(&p);
            String e = err;
            return Err<SceneShader, string>((string)e.data);
        }
    }
    int off = 0;
    for (k in 0..p.uniforms.size) {
        string t = (string)p.uniforms.data[k].type.data;
        if (strcmp(t, "sampler") == 0) {
            List_push(&p.offsets, -1);
            p.textures++;
            continue;
        }
        List_push(&p.offsets, off);
        off += _scene_uniform_size(t);
    }
    p.uniform_bytes = off < 16 ? 16 : off;
    for (i in 0..p.modifiers.size) {
        SceneShaderModifier m = p.modifiers.data[i];
        *String out = &p.bodies[m.entry];
        out.append("    {\n");
        if (m.wgsl) {
            if (m.body != null) out.append(m.body);
            out.append("\n");
        } else {
            GlslTranslator t = glsl_translator("mod_samp");
            for (k in 0..p.uniforms.size) GlslTranslator_declare(&t, (string)p.uniforms.data[k].name.data, (string)p.uniforms.data[k].type.data);
            for (k in 0..p.varyings.size) GlslTranslator_declare(&t, (string)p.varyings.data[k].name.data, (string)p.varyings.data[k].type.data);
            bool ok = GlslTranslator_body(&t, m.body == null ? "" : m.body, out, 2);
            if (!ok) {
                String e;
                e.append((string)t.error.data);
                GlslTranslator_free(&t);
                scene_shader_free(&p);
                return Err<SceneShader, string>((string)e.data);
            }
            GlslTranslator_free(&t);
        }
        out.append("    }\n");
    }
    return Ok<SceneShader, string>(p);
}

// Frees a program.
void scene_shader_free(*SceneShader self) {
    self.modifiers.free();
    for (i in 0..self.uniforms.size) {
        self.uniforms.data[i].name.free();
        self.uniforms.data[i].type.free();
    }
    self.uniforms.free();
    self.offsets.free();
    for (i in 0..self.varyings.size) {
        self.varyings.data[i].name.free();
        self.varyings.data[i].type.free();
    }
    self.varyings.free();
    for (k in 0..5) self.bodies[k].free();
}

bool _scene_prog_has(*SceneShader p, int entry) {
    for (i in 0..p.modifiers.size) {
        if (p.modifiers.data[i].entry == entry) return true;
    }
    return false;
}

string _scene_mod_structs =
    "struct ModGeometry { position: vec3<f32>, normal: vec3<f32>, texcoord: vec2<f32>, tangent: vec4<f32>,\n"
    "    bone_weights: vec4<f32>, bone_indices: vec4<i32> };\n"
    "struct ModTransforms { model_matrix: mat4x4<f32>, view_matrix: mat4x4<f32>, projection_matrix: mat4x4<f32> };\n"
    "struct ModVertex { position: vec4<f32> };\n"
    "struct ModSurface { diffuse_color: vec4<f32>, diffuse_texcoord: vec2<f32>, diffuse_intensity: f32, shininess: f32,\n"
    "    specular_color: vec3<f32>, specular_texcoord: vec2<f32>, roughness: f32, roughness_intensity: f32, metalness: f32,\n"
    "    metalness_intensity: f32, ao: f32, alpha: f32, normal: vec3<f32>, position: vec3<f32>, view: vec3<f32> };\n"
    "struct ModLighting { ambient: vec3<f32>, diffuse: vec3<f32>, specular: vec3<f32>, visibility: f32 };\n"
    "struct ModLight { kind: i32, attenuation_start_distance: f32, attenuation_end_distance: f32,\n"
    "    attenuation_falloff_exp: f32, position: vec4<f32>, direction: vec4<f32>, color: vec3<f32>, intensity: f32,\n"
    "    spot_inner_angle: f32, spot_outer_angle: f32 };\n"
    "fn mod_light(i: u32) -> ModLight {\n"
    "    let li = lights[i];\n"
    "    var m: ModLight;\n"
    "    m.kind = i32(li.position.w + 0.5);\n"
    "    m.attenuation_start_distance = li.atten.x;\n"
    "    m.attenuation_end_distance = li.atten.y;\n"
    "    m.attenuation_falloff_exp = li.atten.z;\n"
    "    m.position = vec4<f32>(li.position.xyz, 1.0);\n"
    "    m.direction = vec4<f32>(li.direction.xyz, 0.0);\n"
    "    m.color = li.color.rgb;\n"
    "    m.intensity = li.color.w;\n"
    "    m.spot_inner_angle = acos(clamp(li.spot.x, -1.0, 1.0));\n"
    "    m.spot_outer_angle = acos(clamp(li.spot.y, -1.0, 1.0));\n"
    "    return m;\n"
    "}\n";

// The let lines that give a modifier body its uniforms by name.
void _scene_mod_lets(*SceneShader p, *String out) {
    for (k in 0..p.uniforms.size) {
        if (p.offsets.data[k] < 0) continue;
        string n = (string)p.uniforms.data[k].name.data;
        out.appendf("    let %s = mu.%s;\n", n, n);
    }
}

// The body of entry point e, its uniforms let first.
void _scene_mod_body(*SceneShader p, int e, *String out) {
    if (p.bodies[e].len == 0) return;
    out.append("    {\n");
    _scene_mod_lets(p, out);
    out.append((string)p.bodies[e].data);
    out.append("    }\n");
}

string _scene_varying_interp(string t) {
    if (t[0] == 'i' || t[0] == 'u' || strcmp(t, "i32") == 0 || strcmp(t, "u32") == 0) return "@interpolate(flat) ";
    return "";
}

// The shader of a key with prog's modifiers: the common prelude with the program's
// varyings, uniforms and textures, then vs, the lighting and fs built around ViroReact's
// entry points.
void _scene_modified_shader(int key, *SceneShader p, *String out) {
    int lighting = scene_key_lighting(key);
    int alpha = scene_key_alpha(key);
    int blend = scene_key_blend(key);
    // the common prelude, the program's varyings added to V
    String common;
    common.append(_scene_common_wgsl);
    String vend;
    vend.append("    @location(5) uv1: vec2<f32>");
    for (k in 0..p.varyings.size) {
        string t = (string)p.varyings.data[k].type.data;
        vend.appendf(", %s@location(%d) %s: %s", _scene_varying_interp(t), 6 + k, (string)p.varyings.data[k].name.data, glsl_wgsl_type(t));
    }
    vend.append(" };\n");
    common.replace_all("    @location(5) uv1: vec2<f32> };\n", (string)vend.data);
    vend.free();
    // the vertex stage is replaced below: keep the prelude up to it
    string full = (string)common.data;
    int64 cut = 0;
    int64 cl = (int64)common.len;
    for (i in 0..cl) {
        if (strncmp(&full[i], "@vertex fn vs(", 14) == 0) {
            cut = i;
            break;
        }
    }
    String head;
    for (i in 0..cut) head.push(full[i]);
    String rest;
    int64 after = cut;
    for (i in cut..cl) {
        if (strncmp(&full[i], "fn tuv(", 7) == 0) {
            after = i;
            break;
        }
    }
    for (i in after..cl) rest.push(full[i]);
    common.free();
    out.append((string)head.data);
    head.free();
    out.append(_scene_mod_structs);
    // the uniform block and textures
    out.append("struct ModU {");
    int fields = 0;
    for (k in 0..p.uniforms.size) {
        if (p.offsets.data[k] < 0) continue;
        out.appendf("%s @align(16) %s: %s", fields > 0 ? "," : "", (string)p.uniforms.data[k].name.data, glsl_wgsl_type((string)p.uniforms.data[k].type.data));
        fields++;
    }
    if (fields == 0) out.append(" pad: vec4<f32>");
    out.append(" };\n@group(3) @binding(0) var<uniform> mu: ModU;\n@group(3) @binding(1) var mod_samp: sampler;\n");
    int tex = 0;
    for (k in 0..p.uniforms.size) {
        if (p.offsets.data[k] >= 0) continue;
        out.appendf("@group(3) @binding(%d) var %s: texture_2d<f32>;\n", 2 + tex, (string)p.uniforms.data[k].name.data);
        tex++;
    }
    // the vertex stage
    out.append("@vertex fn vs(v: In) -> V {\n"
        "    var p = v.pos;\n"
        "    var nrm = v.normal;\n"
        "    morph_apply(v.vi, &p, &nrm);\n"
        "    let sk = skin_matrix(v.joint, v.weight);\n"
        "    let s3 = mat3x3<f32>(sk[0].xyz, sk[1].xyz, sk[2].xyz);\n"
        "    var _geometry: ModGeometry;\n"
        "    _geometry.position = (sk * vec4<f32>(p, 1.0)).xyz;\n"
        "    _geometry.normal = s3 * nrm;\n"
        "    _geometry.texcoord = v.uv;\n"
        "    _geometry.tangent = vec4<f32>(s3 * v.tangent.xyz, v.tangent.w);\n"
        "    _geometry.bone_weights = v.weight;\n"
        "    _geometry.bone_indices = vec4<i32>(v.joint);\n"
        "    var _transforms: ModTransforms;\n"
        "    _transforms.model_matrix = draw.model;\n"
        "    _transforms.view_matrix = frame.view;\n"
        "    _transforms.projection_matrix = frame.proj;\n"
        "    let camera_position = frame.eye.xyz;\n");
    for (k in 0..p.varyings.size) {
        out.appendf("    var %s: %s;\n", (string)p.varyings.data[k].name.data, glsl_wgsl_type((string)p.varyings.data[k].type.data));
    }
    _scene_mod_body(p, SCENE_MODIFIER_GEOMETRY, out);
    out.append("    let world = _transforms.model_matrix * vec4<f32>(_geometry.position, 1.0);\n"
        "    var o: V;\n"
        "    o.world = world.xyz;\n"
        "    let nm = mat3x3<f32>(draw.normal[0].xyz, draw.normal[1].xyz, draw.normal[2].xyz);\n"
        "    o.normal = nm * _geometry.normal;\n"
        "    let mm = mat3x3<f32>(_transforms.model_matrix[0].xyz, _transforms.model_matrix[1].xyz, _transforms.model_matrix[2].xyz);\n"
        "    o.tangent = vec4<f32>(mm * _geometry.tangent.xyz, _geometry.tangent.w);\n"
        "    o.uv = _geometry.texcoord;\n"
        "    o.uv1 = v.uv1;\n"
        "    o.color = v.color;\n"
        "    var _vertex: ModVertex;\n"
        "    _vertex.position = _transforms.projection_matrix * _transforms.view_matrix * world;\n");
    _scene_mod_body(p, SCENE_MODIFIER_VERTEX, out);
    out.append("    o.clip = _vertex.position;\n");
    for (k in 0..p.varyings.size) {
        string n = (string)p.varyings.data[k].name.data;
        out.appendf("    o.%s = %s;\n", n, n);
    }
    out.append("    return o;\n}\n");
    out.append((string)rest.data);
    rest.free();
    // the lighting: the model's own terms per light into _lightingContribution, then the
    // modifiers', accumulated as ViroReact does
    if (lighting == SCENE_CONSTANT) {
        out.append(_scene_constant_wgsl);
        out.append("fn shade_mod(s: Surf, dint: f32, ms: ModSurface) -> vec3<f32> { return s.base.rgb; }\n");
    } else {
        out.append("fn shade_mod(s: Surf, dint: f32, ms: ModSurface) -> vec3<f32> {\n"
            "    var _surface = ms;\n"
            "    let camera_position = frame.eye.xyz;\n"
            "    var amb = vec3<f32>(0.0);\n"
            "    var diff = vec3<f32>(0.0);\n"
            "    var spec = vec3<f32>(0.0);\n");
        if (lighting == SCENE_PBR) {
            out.append("    let a = s.rough * s.rough;\n"
                "    let a2 = a * a;\n"
                "    let f0 = mix(vec3<f32>(0.04), s.base.rgb, s.metal);\n"
                "    let nv = max(dot(s.n, s.v), 1e-4);\n");
        }
        out.append("    let count = u32(draw.info.x);\n"
            "    for (var k = 0u; k < count; k++) {\n"
            "        let i = draw_light(k);\n"
            "        let la = light_at(i, s.pos);\n"
            "        let l = la.xyz;\n"
            "        let radiance = lights[i].color.rgb * lights[i].color.w * la.w;\n"
            "        let nl = max(dot(s.n, l), 0.0);\n"
            "        var _lightingContribution: ModLighting;\n"
            "        _lightingContribution.visibility = shadow_at(i, s.pos, s.geo_n);\n"
            "        var _light = mod_light(i);\n");
        if (lighting == SCENE_PBR) {
            out.append("        let h = normalize(s.v + l);\n"
                "        let nh = max(dot(s.n, h), 0.0);\n"
                "        let vh = max(dot(s.v, h), 0.0);\n"
                "        let f = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);\n"
                "        let dn = nh * nh * (a2 - 1.0) + 1.0;\n"
                "        let d = a2 / (PI * dn * dn);\n"
                "        let gv = nl * sqrt(nv * nv * (1.0 - a2) + a2);\n"
                "        let gl = nv * sqrt(nl * nl * (1.0 - a2) + a2);\n"
                "        let vis = 0.5 / max(gv + gl, 1e-5);\n"
                "        let kd = (1.0 - f) * (1.0 - s.metal);\n"
                "        _lightingContribution.diffuse = kd * radiance * nl;\n"
                "        _lightingContribution.specular = f * d * vis * radiance * nl * PI;\n");
        } else {
            out.append("        _lightingContribution.diffuse = radiance * nl;\n");
            if (lighting == SCENE_PHONG) out.append("        if (nl > 0.0) { _lightingContribution.specular = radiance * pow(max(dot(s.v, reflect(-l, s.n)), 0.0), s.shininess); }\n");
            if (lighting == SCENE_BLINN) out.append("        if (nl > 0.0) { _lightingContribution.specular = radiance * pow(max(dot(normalize(s.v + l), s.n), 0.0), s.shininess); }\n");
        }
        if (p.bodies[SCENE_MODIFIER_LIGHTING].len > 0) {
            out.append("        {\n");
            _scene_mod_lets(p, out);
            out.append((string)p.bodies[SCENE_MODIFIER_LIGHTING].data);
            out.append("        }\n");
        }
        out.append("        amb += _lightingContribution.ambient;\n"
            "        diff += _lightingContribution.diffuse * _lightingContribution.visibility;\n"
            "        spec += _lightingContribution.specular * _lightingContribution.visibility;\n"
            "    }\n");
        if (lighting == SCENE_PBR) {
            out.append("    var color = amb * s.base.rgb + diff * s.base.rgb + spec;\n"
                "    if (frame.ibl.x > 0.5) {\n"
                "        let fa = f0 + (max(vec3<f32>(1.0 - s.rough), f0) - f0) * pow(1.0 - nv, 5.0);\n"
                "        let irr = textureSampleLevel(irr_tex, ibl_samp, s.n, 0.0).rgb;\n"
                "        let pre = textureSampleLevel(spec_tex, ibl_samp, reflect(-s.v, s.n), s.rough * frame.ibl.z).rgb;\n"
                "        let ab = textureSampleLevel(brdf_tex, ibl_samp, vec2<f32>(nv, s.rough), 0.0).rg;\n"
                "        color += (irr * s.base.rgb * (1.0 - s.metal) * (1.0 - fa) + pre * (f0 * ab.x + ab.y)) * s.ao * frame.ibl.y;\n"
                "    } else {\n"
                "        color += frame.ambient.rgb * s.base.rgb * s.ao;\n"
                "    }\n"
                "    return color;\n}\n");
        } else {
            out.append("    return frame.ambient.rgb * s.base.rgb + amb * s.base.rgb + diff * s.base.rgb * dint + spec * s.spec;\n}\n");
        }
    }
    // the fragment stage
    out.append(_scene_fs_head);
    for (k in 0..p.varyings.size) {
        string n = (string)p.varyings.data[k].name.data;
        out.appendf("    var %s = v.%s;\n", n, n);
    }
    out.append("    let camera_position = frame.eye.xyz;\n"
        "    let v_texcoord = v.uv;\n"
        "    let v_surface_position = v.world;\n"
        "    let gl_FragCoord = v.clip;\n"
        "    var _surface: ModSurface;\n"
        "    _surface.diffuse_color = s.base;\n"
        "    _surface.diffuse_texcoord = v.uv;\n"
        "    _surface.diffuse_intensity = mat.extra.x;\n"
        "    _surface.shininess = s.shininess;\n"
        "    _surface.specular_color = s.spec;\n"
        "    _surface.specular_texcoord = v.uv;\n"
        "    _surface.roughness = s.rough;\n"
        "    _surface.roughness_intensity = 1.0;\n"
        "    _surface.metalness = s.metal;\n"
        "    _surface.metalness_intensity = 1.0;\n"
        "    _surface.ao = s.ao;\n"
        "    _surface.alpha = 1.0;\n"
        "    _surface.normal = s.n;\n"
        "    _surface.position = s.pos;\n"
        "    _surface.view = s.v;\n");
    _scene_mod_body(p, SCENE_MODIFIER_SURFACE, out);
    out.append("    s.base = vec4<f32>(_surface.diffuse_color.rgb, _surface.diffuse_color.a * _surface.alpha);\n"
        "    s.spec = _surface.specular_color;\n"
        "    s.shininess = _surface.shininess;\n"
        "    s.rough = clamp(_surface.roughness * _surface.roughness_intensity, 0.04, 1.0);\n"
        "    s.metal = clamp(_surface.metalness * _surface.metalness_intensity, 0.0, 1.0);\n"
        "    s.ao = _surface.ao;\n"
        "    s.n = normalize(_surface.normal);\n"
        "    s.pos = _surface.position;\n"
        "    s.v = _surface.view;\n");
    if (alpha == SCENE_ALPHA_MASK) out.append("    if (s.base.a < mat.emissive.w) { discard; }\n");
    out.append("    var color = shade_mod(s, _surface.diffuse_intensity, _surface) + mat.emissive.rgb * e_s;\n");
    if (alpha == SCENE_ALPHA_BLEND) out.append("    var alpha = clamp(s.base.a * draw.info.w, 0.0, 1.0);\n");
    else if (scene_key_blended(key)) out.append("    var alpha = clamp(draw.info.w, 0.0, 1.0);\n");
    else out.append("    var alpha = 1.0;\n");
    out.append("    var _output_color = vec4<f32>(color, alpha);\n");
    _scene_mod_body(p, SCENE_MODIFIER_FRAGMENT, out);
    out.append("    color = _output_color.rgb;\n");
    if (!scene_key_blended(key)) {
        out.append("    return vec4<f32>(color, 1.0);\n}\n");
        return;
    }
    out.append("    alpha = clamp(_output_color.a, 0.0, 1.0);\n");
    if (blend == SCENE_BLEND_MULTIPLY) out.append("    color = mix(vec3<f32>(1.0), color, alpha);\n");
    if (blend == SCENE_BLEND_SCREEN) out.append("    color = clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)) * alpha;\n");
    out.append("    return vec4<f32>(color, alpha);\n}\n");
}

string _scene_shadow_wgsl =
    "struct Pass { vp: mat4x4<f32> };\n"
    "struct Draw { model: mat4x4<f32>, normal: mat4x4<f32>, lights: array<vec4<u32>, 2>, info: vec4<f32>, morph: vec4<f32> };\n"
    "@group(0) @binding(0) var<uniform> sp: Pass;\n"
    "@group(1) @binding(0) var<uniform> draw: Draw;\n"
    "@group(1) @binding(1) var<storage, read> joints: array<mat4x4<f32>>;\n"
    "@group(1) @binding(2) var<storage, read> morph: array<vec4<f32>>;\n"
    "@group(1) @binding(3) var<storage, read> weights: array<f32>;\n"
    SCENE_DEFORM_WGSL
    "@vertex fn vs(@builtin(vertex_index) vi: u32, @location(0) pos: vec3<f32>, @location(6) joint: vec4<f32>,\n"
    "              @location(7) weight: vec4<f32>) -> @builtin(position) vec4<f32> {\n"
    "    var p = pos;\n"
    "    var nrm = vec3<f32>(0.0, 0.0, 1.0);\n"
    "    morph_apply(vi, &p, &nrm);\n"
    "    return sp.vp * (draw.model * (skin_matrix(joint, weight) * vec4<f32>(p, 1.0)));\n"
    "}\n";
