// sky.esk: the background of a scene (`<scene/sky>`).
//
// Behind everything a scene shows a solid color (Scene.background), a cube
// map (an environment from `<gpu/ibl>`, GpuIbl.environment, with Scene_set_skybox,
// or six images with Scene_set_skybox_faces), or a 360 image, equirectangular, with
// Scene_set_sky_360 (ViroReact's Viro360Image). Scene.sky_rotation turns it.
//
//     GpuIbl ibl = gpu.ibl(&sky_hdr, null)?;
//     scene.set_skybox(&ibl.environment);
//     scene.set_ibl(&ibl);               // PBR materials take their ambient light from it
//
// scene_cube_faces makes the cube of six images on its own.

import <mem>;
import <result>;
import <gpu/raw>;
import <gpu/core>;
import <gpu/render>;
import <gpu/math>;
import <gpu/image>;

// A cube texture from six square images of the same size, in the order +X (right), -X
// (left), +Y (top), -Y (bottom), +Z (front), -Z (back), stored as sRGB with mipmaps made on
// the GPU. These are the usual skybox image sets (OpenGL's cube map convention): drawn
// with Scene_set_skybox_faces, the +Z image is what a camera looking down -Z sees.
Result<GpuTexture, string> scene_cube_faces(*Gpu gpu, *Bitmap faces) {
    uint32 size = faces[0].width;
    for (i in 0..6) {
        if (faces[i].width != size || faces[i].height != size || faces[i].rgba == null) {
            return Err<GpuTexture, string>("scene: cube faces must be square images of one size");
        }
    }
    GpuTextureDesc d = GpuTextureDesc{width: size, height: size, format: WGPUTextureFormat_RGBA8UnormSrgb,
        cube: true, mipmaps: true};
    GpuTexture t = gpu.texture_with(&d)?;
    for (i in 0..6) {
        Result<int, string> w = t.write_level((uint32)i, 0, faces[i].rgba);
        if (!w.ok) {
            t.release();
            return Err<GpuTexture, string>(w.error);
        }
    }
    Result<int, string> m = t.generate_mips();
    if (!m.ok) {
        t.release();
        return Err<GpuTexture, string>(m.error);
    }
    return Ok<GpuTexture, string>(t);
}

string _scene_sky_head =
    "struct Sky { inv_vp: mat4x4<f32>, rot: mat4x4<f32>, params: vec4<f32> };\n"
    "@group(0) @binding(0) var<uniform> sky: Sky;\n"
    "@group(0) @binding(2) var samp: sampler;\n"
    "struct V { @builtin(position) pos: vec4<f32>, @location(0) ndc: vec2<f32> };\n"
    "@vertex fn vs(@builtin(vertex_index) i: u32) -> V {\n"
    "    let p = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u)) * 2.0 - 1.0;\n"
    "    var o: V;\n"
    "    o.pos = vec4<f32>(p, 1.0, 1.0);\n"
    "    o.ndc = p;\n"
    "    return o;\n"
    "}\n"
    "fn sky_dir(v: V) -> vec3<f32> {\n"
    "    let far = sky.inv_vp * vec4<f32>(v.ndc, 1.0, 1.0);\n"
    "    let near = sky.inv_vp * vec4<f32>(v.ndc, 0.0, 1.0);\n"
    "    return (sky.rot * vec4<f32>(normalize(far.xyz / far.w - near.xyz / near.w), 0.0)).xyz;\n"
    "}\n";

string _scene_sky_cube_wgsl =
    "@group(0) @binding(1) var cube: texture_cube<f32>;\n"
    "@fragment fn fs(v: V) -> @location(0) vec4<f32> {\n"
    "    var d = sky_dir(v);\n"
    "    if (sky.params.y > 0.5) { d.z = -d.z; }\n"
    "    return vec4<f32>(textureSample(cube, samp, d).rgb * sky.params.x, 1.0);\n"
    "}\n";

// An equirectangular image: longitude across, latitude down, its center straight ahead
// down -Z, +Y at the top row. The mip level comes from the longitude that is continuous
// across the pixel, so the seam at the back does not pick the smallest mip.
string _scene_sky_360_wgsl =
    "@group(0) @binding(1) var pano: texture_2d<f32>;\n"
    "@fragment fn fs(v: V) -> @location(0) vec4<f32> {\n"
    "    let d = normalize(sky_dir(v));\n"
    "    let pi = 3.14159265358979;\n"
    "    let uv = vec2<f32>(0.5 + atan2(d.x, -d.z) / (2.0 * pi), acos(clamp(d.y, -1.0, 1.0)) / pi);\n"
    "    let u2 = fract(uv.x + 0.5) - 0.5;\n"
    "    let wrap = fwidth(u2) < fwidth(uv.x);\n"
    "    let gx = vec2<f32>(select(dpdx(uv.x), dpdx(u2), wrap), dpdx(uv.y));\n"
    "    let gy = vec2<f32>(select(dpdy(uv.x), dpdy(u2), wrap), dpdy(uv.y));\n"
    "    return vec4<f32>(textureSampleGrad(pano, samp, uv, gx, gy).rgb * sky.params.x, 1.0);\n"
    "}\n";

struct _SceneSkyGpu {
    bool made;
    GpuBindLayout layout;
    GpuPipeline pipe;
    GpuBuffer uniforms;
    GpuBindGroup group;
    GpuSampler samp;
    WGPUTextureView bound;
    GpuBindLayout layout360;
    GpuPipeline pipe360;
    GpuPipeline pipe_masked;
    GpuPipeline pipe360_masked;
    GpuBindGroup group360;
    GpuSampler samp360;
    WGPUTextureView bound360;
}

Result<GpuPipeline, string> _scene_sky_pipe(*Gpu gpu, *GpuBindLayout layout, string body, bool masked) {
    String src;
    defer src.free();
    src.append(_scene_sky_head);
    src.append(body);
    *GpuBindLayout[1] groups = {layout};
    GpuPipelineDesc d = GpuPipelineDesc{wgsl: (string)src.data, vertex: "vs", fragment: "fs",
        format: WGPUTextureFormat_RGBA16Float, groups: &groups[0], group_count: 1, depth: true,
        depth_format: WGPUTextureFormat_Depth24PlusStencil8, depth_compare: WGPUCompareFunction_LessEqual,
        depth_read_only: true};
    if (masked) d.stencil_front = GpuStencilFace{compare: WGPUCompareFunction_Equal};
    return gpu.pipeline(&d);
}

Result<int, string> _scene_sky_make(*_SceneSkyGpu self, *Gpu gpu) {
    self.layout = gpu.bind_layout();
    self.layout.uniform(0, WGPUShaderStage_Fragment);
    self.layout.texture(1, WGPUShaderStage_Fragment, WGPUTextureSampleType_Float, WGPUTextureViewDimension_Cube);
    self.layout.sampler(2, WGPUShaderStage_Fragment, WGPUSamplerBindingType_Filtering);
    self.pipe = _scene_sky_pipe(gpu, &self.layout, _scene_sky_cube_wgsl, false)?;
    self.pipe_masked = _scene_sky_pipe(gpu, &self.layout, _scene_sky_cube_wgsl, true)?;
    self.layout360 = gpu.bind_layout();
    self.layout360.uniform(0, WGPUShaderStage_Fragment);
    self.layout360.texture(1, WGPUShaderStage_Fragment, WGPUTextureSampleType_Float, WGPUTextureViewDimension_2D);
    self.layout360.sampler(2, WGPUShaderStage_Fragment, WGPUSamplerBindingType_Filtering);
    self.pipe360 = _scene_sky_pipe(gpu, &self.layout360, _scene_sky_360_wgsl, false)?;
    self.pipe360_masked = _scene_sky_pipe(gpu, &self.layout360, _scene_sky_360_wgsl, true)?;
    self.uniforms = gpu.uniform(null, 144)?;
    GpuSamplerOptions so360 = GpuSamplerOptions{mipmaps: true, wrap_u: WGPUAddressMode_Repeat,
        wrap_v: WGPUAddressMode_ClampToEdge};
    self.samp360 = gpu.sampler_with(&so360)?;
    self.group360 = self.layout360.group()?;
    self.group360.buffer(0, &self.uniforms);
    self.group360.sampler(2, &self.samp360);
    GpuSamplerOptions so = GpuSamplerOptions{mipmaps: true, wrap_u: WGPUAddressMode_ClampToEdge,
        wrap_v: WGPUAddressMode_ClampToEdge};
    self.samp = gpu.sampler_with(&so)?;
    self.group = self.layout.group()?;
    self.group.buffer(0, &self.uniforms);
    self.group.sampler(2, &self.samp);
    self.made = true;
    return Ok<int, string>(0);
}

// Draws the sky: tex is a cube map, or an equirectangular 2D image when pano. rotation
// turns the sky in the world.
void _scene_sky_draw(*_SceneSkyGpu self, *GpuPass pass, *GpuTexture tex, bool pano, Mat4 view_proj, Quat rotation,
                     float intensity, bool flip, bool masked) {
    float[36] u;
    Mat4 inv = view_proj.inverse();
    Mat4 rot = mat4_trs(Vec3{0.0, 0.0, 0.0}, rotation.conjugate(), Vec3{1.0, 1.0, 1.0});
    for (i in 0..16) u[i] = inv.m[i];
    for (i in 0..16) u[16 + i] = rot.m[i];
    u[32] = intensity;
    u[33] = flip ? 1.0 : 0.0;
    self.uniforms.write(0, &u, 144);
    if (pano) {
        if (self.bound360 != tex.view) {
            self.group360.texture(1, tex);
            self.bound360 = tex.view;
        }
        pass.set_group(0, &self.group360);
        pass.draw(masked ? &self.pipe360_masked : &self.pipe360, null, 3, 1);
        return;
    }
    if (self.bound != tex.view) {
        self.group.texture(1, tex);
        self.bound = tex.view;
    }
    pass.set_group(0, &self.group);
    pass.draw(masked ? &self.pipe_masked : &self.pipe, null, 3, 1);
}

void _scene_sky_release(*_SceneSkyGpu self) {
    if (!self.made) return;
    self.group.release();
    self.uniforms.release();
    self.samp.release();
    self.pipe.release();
    self.layout.release();
    self.group360.release();
    self.samp360.release();
    self.pipe360.release();
    self.pipe_masked.release();
    self.pipe360_masked.release();
    self.layout360.release();
    self.made = false;
}
