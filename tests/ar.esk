// AR rendering: the camera picture behind the scene (Scene.camera_background), covered by
// opaque surfaces, mixed under blended ones and brightened by additive ones, untouched by
// tone mapping; a camera given its projection matrix (scene_projection) drawing what the
// same perspective camera draws; and a shadow catcher: invisible over the camera but where a
// shadow falls on it, lighter with ambient light.
import <io>;
import <mem>;
import <libc>;
import <gpu>;
import <gpu/math>;
import <scene>;

const int N = 32;
int fails = 0;

void check(string what, bool ok) {
    if (!ok) {
        printf("FAIL %s\n", what);
        fails++;
    }
}

bool near(int a, int b, int tol) {
    return a - b <= tol && b - a <= tol;
}

*uint8 at(*uint8 px, int x, int y) {
    return px + (y * N + x) * 4;
}

Result<int, string> run() {
    Gpu gpu = gpu_open()?;
    defer gpu.release();
    Scene scene = gpu.scene()?;
    defer scene.release();
    scene.post.tone_mapping = SCENE_TONE_HABLE;
    scene.background = Vec4{0.0, 0.0, 0.0, 0.0};
    GpuTexture target = gpu.target_with((uint32)N, (uint32)N, WGPUTextureFormat_RGBA8Unorm)?;
    defer target.release();
    *uint8 px = alloc<uint8>(N * N * 4);
    defer free(px);
    // the camera picture: a flat display color
    uint8[4] grey = {100, 150, 200, 255};
    GpuImageOptions lo = GpuImageOptions{srgb: false};
    scene.camera_background = scene.add_texture(gpu.image_with(1, 1, &grey[0], &lo)?);
    SceneGeometry q = scene_quad(1.0, 1.0);
    int quad = scene.add_geometry(&q)?;
    q.free();
    int cam = scene.add_camera(0, scene_orthographic(2.0, 0.1, 20.0));
    scene.node(cam).position = Vec3{0.0, 0.0, 5.0};
    scene.set_camera(cam);

    scene.render_to(&target)?;
    target.read(px)?;
    check("an empty scene shows the camera as it is", near((int)at(px, 16, 16)[0], 100, 1) && near((int)at(px, 16, 16)[1], 150, 1) &&
        near((int)at(px, 16, 16)[2], 200, 1));

    // opaque white: covers the camera
    SceneMaterial w = scene_material(SCENE_CONSTANT);
    w.diffuse = Vec4{0.3, 0.3, 0.3, 1.0};
    int obj = scene.add_object(0, quad, scene.add_material(w));
    scene.post.tone_mapping = SCENE_TONE_NONE;
    scene.render_to(&target)?;
    target.read(px)?;
    // 0.3 linear is 149 in sRGB
    check("an opaque surface covers the camera", near((int)at(px, 16, 16)[0], 149, 2) && near((int)at(px, 16, 16)[2], 149, 2));
    check("around it the camera", near((int)at(px, 2, 2)[0], 100, 1));

    // additive red: the camera shows through, red added
    SceneMaterial add = scene_material(SCENE_CONSTANT);
    add.diffuse = Vec4{0.2, 0.0, 0.0, 1.0};
    add.alpha_mode = SCENE_ALPHA_BLEND;
    add.blend_mode = SCENE_BLEND_ADD;
    scene.node(obj).material = scene.add_material(add);
    scene.render_to(&target)?;
    target.read(px)?;
    *uint8 p = at(px, 16, 16);
    check("an additive surface glows over the camera", (int)p[0] > 130 && near((int)p[1], 150, 2) && near((int)p[2], 200, 2));

    // half-transparent black: halfway to black
    SceneMaterial half = scene_material(SCENE_CONSTANT);
    half.diffuse = Vec4{0.0, 0.0, 0.0, 0.5};
    half.alpha_mode = SCENE_ALPHA_BLEND;
    scene.node(obj).material = scene.add_material(half);
    scene.render_to(&target)?;
    target.read(px)?;
    p = at(px, 16, 16);
    check("a blended surface mixes with the camera", near((int)p[0], 50, 3) && near((int)p[2], 100, 3));
    scene.camera_background = 0;

    // a camera with the perspective camera's own matrix draws the same picture
    SceneMaterial m = scene_material(SCENE_CONSTANT);
    m.diffuse = Vec4{1.0, 1.0, 1.0, 1.0};
    scene.node(obj).material = scene.add_material(m);
    scene.node(obj).position = Vec3{0.3, 0.1, 0.0};
    scene.background = Vec4{0.0, 0.0, 0.0, 1.0};
    *SceneCamera c = scene.camera(cam);
    *c = scene_perspective(0.9, 0.1, 20.0);
    scene.render_to(&target)?;
    *uint8 first = alloc<uint8>(N * N * 4);
    defer free(first);
    target.read(first)?;
    *c = scene_projection(mat4_perspective(0.9, 1.0, 0.1, 20.0), 0.1, 20.0);
    scene.render_to(&target)?;
    target.read(px)?;
    int diff = 0;
    for (i in 0..N * N * 4) {
        int d = (int)first[i] - (int)px[i];
        if (d > 1 || d < -1) diff++;
    }
    check("a given projection matches the perspective camera", diff == 0);
    return Ok<int, string>(0);
}

Result<int, string> catcher(*Gpu gpu) {
    Scene scene = gpu.scene()?;
    defer scene.release();
    scene.post.tone_mapping = SCENE_TONE_NONE;
    scene.background = Vec4{0.0, 0.0, 0.0, 0.0};
    scene.shadow_size = 512;
    uint8[4] grey = {120, 120, 120, 255};
    GpuImageOptions lo = GpuImageOptions{srgb: false};
    scene.camera_background = scene.add_texture(gpu.image_with(1, 1, &grey[0], &lo)?);
    SceneGeometry pg = scene_plane(4.0, 4.0);
    int plane = scene.add_geometry(&pg)?;
    pg.free();
    SceneGeometry bg = scene_box(1.0, 0.2, 1.0);
    int box = scene.add_geometry(&bg)?;
    bg.free();
    SceneMaterial cm = scene_material(SCENE_PBR);
    cm.shadow_catcher = true;
    scene.add_object(0, plane, scene.add_material(cm));
    int occluder = scene.add_object(0, box, scene.add_material(scene_material(SCENE_LAMBERT)));
    scene.node(occluder).position = Vec3{0.0, 1.0, 0.0};
    int cam = scene.add_camera(0, scene_orthographic(4.0, 0.1, 20.0));
    scene.node(cam).position = Vec3{0.0, 6.0, 0.0};
    scene.look_at(cam, Vec3{0.0, 0.0, 0.0}, Vec3{0.0, 0.0, -1.0});
    scene.set_camera(cam);
    int sun = scene.add_light(scene_directional(Vec3{1.0, -1.0, 0.0}, Vec3{1.0, 1.0, 1.0}, 1.0));
    scene.light(sun).casts_shadows = true;
    GpuTexture target = gpu.target_with(64, 64, WGPUTextureFormat_RGBA8Unorm)?;
    defer target.release();
    *uint8 px = alloc<uint8>(64 * 64 * 4);
    defer free(px);
    scene.render_to(&target)?;
    target.read(px)?;
    // ground point (x, z) of the top view at pixel ((x + 2) / 4 * 64, (z + 2) / 4 * 64)
    int open = (int)px[(32 * 64 + 6) * 4];
    int shade = (int)px[(32 * 64 + 48) * 4];
    check("the catcher is invisible where nothing shadows it", near(open, 120, 1));
    check("and black where the box's shadow falls", shade < 6);
    scene.add_light(scene_ambient(Vec3{1.0, 1.0, 1.0}, 0.4));
    scene.render_to(&target)?;
    target.read(px)?;
    shade = (int)px[(32 * 64 + 48) * 4];
    // 40% ambient: the shadow 60% opaque, the camera at 40% (120 * 0.4 = 48)
    check("ambient light softens the shadow", near(shade, 48, 4));
    return Ok<int, string>(0);
}

// Chroma key: a green and red picture over blue; the green goes, the red stays.
Result<int, string> chroma(*Gpu gpu) {
    Scene scene = gpu.scene()?;
    defer scene.release();
    scene.post.tone_mapping = SCENE_TONE_NONE;
    scene.post.gamma = false;
    scene.background = Vec4{0.0, 0.0, 1.0, 1.0};
    uint8[8] img = {0, 255, 0, 255, 255, 0, 0, 255};
    GpuImageOptions lo = GpuImageOptions{srgb: false};
    int tex = scene.add_texture(gpu.image_with(2, 1, &img[0], &lo)?);
    SceneGeometry q = scene_quad(2.0, 2.0);
    int quad = scene.add_geometry(&q)?;
    q.free();
    SceneMaterial m = scene_material(SCENE_CONSTANT);
    m.diffuse_texture = tex;
    m.filter = SCENE_FILTER_NEAREST;
    m.chroma_key = true;
    m.chroma_key_color = Vec3{0.0, 1.0, 0.0};
    scene.add_object(0, quad, scene.add_material(m));
    int cam = scene.add_camera(0, scene_orthographic(2.0, 0.1, 20.0));
    scene.node(cam).position = Vec3{0.0, 0.0, 5.0};
    scene.set_camera(cam);
    GpuTexture target = gpu.target_with((uint32)N, (uint32)N, WGPUTextureFormat_RGBA8Unorm)?;
    defer target.release();
    *uint8 px = alloc<uint8>(N * N * 4);
    defer free(px);
    scene.render_to(&target)?;
    target.read(px)?;
    *uint8 l = at(px, 6, 16);
    *uint8 r = at(px, 26, 16);
    check("the key color is transparent", l[0] < 3 && l[1] < 3 && l[2] > 250);
    check("other colors stay", r[0] > 250 && r[2] < 3);
    return Ok<int, string>(0);
}

// Depth occlusion: a red wall 5 m away behind a real surface 1 m away on the left half and
// 10 m away on the right half: hidden on the left, seen on the right; then turned (the
// transform) so the near half is on the right.
Result<int, string> occlusion(*Gpu gpu) {
    Scene scene = gpu.scene()?;
    defer scene.release();
    scene.post.tone_mapping = SCENE_TONE_NONE;
    scene.post.gamma = false;
    scene.background = Vec4{0.0, 0.0, 1.0, 1.0};
    SceneGeometry q = scene_quad(1.0, 1.0);
    int quad = scene.add_geometry(&q)?;
    q.free();
    SceneMaterial m = scene_material(SCENE_CONSTANT);
    m.diffuse = Vec4{1.0, 0.0, 0.0, 1.0};
    int wall = scene.add_object(0, quad, scene.add_material(m));
    scene.node(wall).position = Vec3{0.0, 0.0, -5.0};
    scene.node(wall).scale = Vec3{40.0, 40.0, 1.0};
    int cam = scene.add_camera(0, scene_perspective(1.0, 0.1, 50.0));
    scene.set_camera(cam);
    GpuTextureDesc dd = GpuTextureDesc{width: 2, height: 1, format: WGPUTextureFormat_R32Float,
        usage: WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst};
    GpuTexture depth = gpu.texture_with(&dd)?;
    float[2] meters = {1.0, 10.0};
    depth.write_level(0, 0, &meters[0])?;
    scene.occlusion_depth = scene.add_texture(depth);
    GpuTexture target = gpu.target_with((uint32)N, (uint32)N, WGPUTextureFormat_RGBA8Unorm)?;
    defer target.release();
    *uint8 px = alloc<uint8>(N * N * 4);
    defer free(px);
    scene.render_to(&target)?;
    target.read(px)?;
    check("behind a nearer real surface: hidden", at(px, 6, 16)[0] < 3 && at(px, 6, 16)[2] > 250);
    check("in front of a farther one: seen", at(px, 26, 16)[0] > 250);
    // mirrored: view x maps to 1 - x in the depth image
    scene.occlusion_transform = mat4_trs(Vec3{1.0, 0.0, 0.0}, quat_identity(), Vec3{-1.0, 1.0, 1.0});
    scene.render_to(&target)?;
    target.read(px)?;
    check("the transform maps the view to the depth image", at(px, 6, 16)[0] > 250 && at(px, 26, 16)[0] < 3);
    scene.occlusion_depth = 0;
    scene.render_to(&target)?;
    target.read(px)?;
    check("no occlusion without depth", at(px, 26, 16)[0] > 250 && at(px, 6, 16)[0] > 250);
    return Ok<int, string>(0);
}

// An occluder (no_color_write): invisible, yet what is behind it is hidden.
Result<int, string> occluder(*Gpu gpu) {
    Scene scene = gpu.scene()?;
    defer scene.release();
    scene.post.tone_mapping = SCENE_TONE_NONE;
    scene.post.gamma = false;
    scene.background = Vec4{0.0, 0.0, 1.0, 1.0};
    SceneGeometry q = scene_quad(1.0, 1.0);
    int quad = scene.add_geometry(&q)?;
    q.free();
    SceneMaterial red = scene_material(SCENE_CONSTANT);
    red.diffuse = Vec4{1.0, 0.0, 0.0, 1.0};
    int far_wall = scene.add_object(0, quad, scene.add_material(red));
    scene.node(far_wall).position = Vec3{0.0, 0.0, -5.0};
    scene.node(far_wall).scale = Vec3{40.0, 40.0, 1.0};
    SceneMaterial occ = scene_material(SCENE_CONSTANT);
    occ.diffuse = Vec4{0.0, 1.0, 0.0, 1.0};
    occ.no_color_write = true;
    int near_wall = scene.add_object(0, quad, scene.add_material(occ));
    scene.node(near_wall).position = Vec3{-1.0, 0.0, -2.0};
    scene.node(near_wall).scale = Vec3{2.0, 4.0, 1.0};
    // the occluder is drawn before what it hides
    scene.node(near_wall).rendering_order = -1;
    int cam = scene.add_camera(0, scene_perspective(1.0, 0.1, 50.0));
    scene.set_camera(cam);
    GpuTexture target = gpu.target_with((uint32)N, (uint32)N, WGPUTextureFormat_RGBA8Unorm)?;
    defer target.release();
    *uint8 px = alloc<uint8>(N * N * 4);
    defer free(px);
    scene.render_to(&target)?;
    target.read(px)?;
    check("behind the occluder: the background", at(px, 6, 16)[0] < 3 && at(px, 6, 16)[1] < 3 && at(px, 6, 16)[2] > 250);
    check("beside it: the wall", at(px, 26, 16)[0] > 250);
    return Ok<int, string>(0);
}
// Semantic masks: a red wall over labels that are sky on the left half and building on the
// right: shown only on the sky, hidden on the sky, colored by label; the confidence fades it.
Result<int, string> semantics(*Gpu gpu) {
    Scene scene = gpu.scene()?;
    defer scene.release();
    scene.post.tone_mapping = SCENE_TONE_NONE;
    scene.post.gamma = false;
    scene.background = Vec4{0.0, 0.0, 1.0, 1.0};
    SceneGeometry q = scene_quad(1.0, 1.0);
    int quad = scene.add_geometry(&q)?;
    q.free();
    List<SceneShaderModifier> show;
    List_push(&show, scene_semantic_mask(SCENE_SEMANTIC_SHOW_ONLY, scene_semantic_label(1)));
    List<SceneShaderModifier> hide;
    List_push(&hide, scene_semantic_mask(SCENE_SEMANTIC_HIDE, scene_semantic_label(1)));
    List<SceneShaderModifier> debug;
    List_push(&debug, scene_semantic_mask(SCENE_SEMANTIC_DEBUG, 0));
    SceneMaterial m = scene_material(SCENE_CONSTANT);
    m.diffuse = Vec4{1.0, 0.0, 0.0, 1.0};
    m.alpha_mode = SCENE_ALPHA_BLEND;
    m.shader = scene.add_shader(&show)?;
    int mat = scene.add_material(m);
    int wall = scene.add_object(0, quad, mat);
    scene.node(wall).position = Vec3{0.0, 0.0, -5.0};
    scene.node(wall).scale = Vec3{40.0, 40.0, 1.0};
    int cam = scene.add_camera(0, scene_perspective(1.0, 0.1, 50.0));
    scene.set_camera(cam);
    GpuTextureDesc ld = GpuTextureDesc{width: 4, height: 1, format: WGPUTextureFormat_R8Unorm,
        usage: WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst};
    GpuTexture labels = gpu.texture_with(&ld)?;
    uint8[4] sky_building = {1, 1, 2, 2};
    labels.write_level(0, 0, &sky_building[0])?;
    scene.semantic_texture = scene.add_texture(labels);
    GpuTexture target = gpu.target_with((uint32)N, (uint32)N, WGPUTextureFormat_RGBA8Unorm)?;
    defer target.release();
    *uint8 px = alloc<uint8>(N * N * 4);
    defer free(px);
    scene.render_to(&target)?;
    target.read(px)?;
    check("shown only on the sky", at(px, 6, 16)[0] > 250 && at(px, 26, 16)[0] < 3 && at(px, 26, 16)[2] > 250);
    scene.material(mat).shader = scene.add_shader(&hide)?;
    scene.render_to(&target)?;
    target.read(px)?;
    check("hidden on the sky", at(px, 6, 16)[0] < 3 && at(px, 26, 16)[0] > 250);
    // half confident: the sky shows half the wall
    GpuTexture conf = gpu.texture_with(&ld)?;
    uint8[4] half = {128, 128, 128, 128};
    conf.write_level(0, 0, &half[0])?;
    scene.semantic_confidence_texture = scene.add_texture(conf);
    scene.material(mat).shader = scene.add_shader(&show)?;
    scene.render_to(&target)?;
    target.read(px)?;
    check("the confidence fades it", near((int)at(px, 6, 16)[0], 128, 4) && near((int)at(px, 6, 16)[2], 127, 4));
    scene.material(mat).shader = scene.add_shader(&debug)?;
    scene.render_to(&target)?;
    target.read(px)?;
    check("colored by label", near((int)at(px, 6, 16)[0], 23, 3) && near((int)at(px, 26, 16)[0], 46, 3) && near((int)at(px, 26, 16)[1], 204, 3));
    // mirrored: the building on the left
    scene.semantic_transform = mat4_trs(Vec3{1.0, 0.0, 0.0}, quat_identity(), Vec3{-1.0, 1.0, 1.0});
    scene.material(mat).shader = scene.add_shader(&hide)?;
    scene.semantic_confidence_texture = 0;
    scene.render_to(&target)?;
    target.read(px)?;
    check("the transform maps the view to the labels", at(px, 6, 16)[0] > 250 && at(px, 26, 16)[0] < 3);
    show.free();
    hide.free();
    debug.free();
    return Ok<int, string>(0);
}

int main() {
    Result<int, string> r = run();
    if (r.ok) {
        Result<Gpu, string> g = gpu_open();
        if (g.ok) {
            Gpu gpu = g.value;
            r = catcher(&gpu);
            if (r.ok) r = chroma(&gpu);
            if (r.ok) r = occlusion(&gpu);
            if (r.ok) r = occluder(&gpu);
            if (r.ok) r = semantics(&gpu);
            gpu.release();
        }
    }
    if (!r.ok) {
        printf("FAIL %s\n", r.error);
        return 1;
    }
    if (fails > 0) return 1;
    printf("ar: ok\n");
    return 0;
}
