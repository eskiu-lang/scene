// Text: sizes in ViroReact's units (0.01 world units a point), word, character and no
// wrapping, justification to the box width, clipping and the line cap, alignment of the
// laid-out glyphs, rebuilding a text node, and the glyphs drawn where the layout puts them.
import <io>;
import <mem>;
import <list>;
import <libc>;
import <gpu>;
import <gpu/math>;
import <font/ttf>;
import <scene>;
import <scene/text>;

const int N = 64;
int fails = 0;

void check(string what, bool ok) {
    if (!ok) {
        printf("FAIL %s\n", what);
        fails++;
    }
}

bool near(float a, float b, float tol) {
    return a - b < tol && b - a < tol;
}

float advance(*Font f, string s, float size) {
    float w = 0.0;
    for (i in 0..strlen(s)) w += (float)f.advance(f.glyph((uint32)(uint8)s[i])) * f.scale(size) * 0.01;
    return w;
}

float half_to_float(uint16 h) {
    int e = ((int)h >> 10) & 31;
    int m = (int)h & 1023;
    float v = 0.0;
    if (e == 0) v = (float)m / 1024.0 / 16384.0;
    else v = (1.0 + (float)m / 1024.0) * (float)pow(2.0, (double)(e - 15));
    return (h & 0x8000) != 0 ? -v : v;
}

// Knuth-Plass demerits of a layout's lines (ViroReact's weights): each line's stretch ratio
// over its spaces (a half space each), badness 100 |r|^3, (10 + badness)^2, 3000 when the
// fitness class jumps; the last line is free.
float kp_demerits(*Font f, *_SceneTextLayout l, float width) {
    float space = (float)f.advance(f.glyph(32)) * f.scale(18.0) * 0.01;
    float total = 0.0;
    int prev = 0;
    for (li in 0..l.lines.size) {
        _SceneTextLine ln = l.lines.data[li];
        float lw = 0.0;
        int spaces = 0;
        for (k in 0..ln.count) {
            uint32 c = l.cps.data[ln.start + k];
            lw += (float)f.advance(f.glyph(c)) * f.scale(18.0) * 0.01;
            if (c == 32) spaces++;
        }
        float r = 0.0;
        if (li < l.lines.size - 1) r = spaces > 0 ? (width - lw) / ((float)spaces * space * 0.5) : 10000.0;
        float bad = 100.0 * (r < 0.0 ? -r * r * r : r * r * r);
        total += (10.0 + bad) * (10.0 + bad);
        int cls = r < -0.5 ? 0 : (r <= 0.5 ? 1 : (r <= 1.0 ? 2 : 3));
        if (cls - prev > 1 || prev - cls > 1) total += 3000.0;
        prev = cls;
    }
    return total;
}

Result<int, string> run() {
    Font f = font_load("tests/data/DejaVuSans-Latin1.ttf")?;
    defer f.free();
    SceneTextStyle st = scene_text_style();
    check("ViroText defaults", st.size == 18.0 && st.width == 1.0 && st.height == 1.0 && st.line_break == SCENE_TEXT_WORD_WRAP);
    float lh = f.line_height(18.0) * 0.01;

    float w = 0.0;
    float h = 0.0;
    scene_text_size(&f, "Hello", st, &w, &h);
    check("one line: width is the advances at 0.01 a point", near(w, advance(&f, "Hello", 18.0), 1e-5) && near(h, lh, 1e-5));

    // word wrap in a box 1 unit wide
    string words = "aaaa bbbb cccc dddd eeee ffff";
    scene_text_size(&f, words, st, &w, &h);
    int lines = (int)(h / lh + 0.5);
    check("wraps by words", lines >= 2 && w <= 1.0);
    // no wrap: one line as wide as the whole text, a newline still breaks
    SceneTextStyle nw = st;
    nw.line_break = SCENE_TEXT_NO_WRAP;
    scene_text_size(&f, words, nw, &w, &h);
    check("no wrap: one line", near(h, lh, 1e-5) && near(w, advance(&f, words, 18.0), 1e-4));
    scene_text_size(&f, "ab\ncd", nw, &w, &h);
    check("no wrap breaks at a newline", near(h, 2.0 * lh, 1e-5));
    // character wrap fills each line closer to the width than word wrap
    SceneTextStyle cw = st;
    cw.line_break = SCENE_TEXT_CHAR_WRAP;
    scene_text_size(&f, words, cw, &w, &h);
    check("char wrap: lines fit", w <= 1.0 && w > 0.9);
    // the line cap and clipping to the box height
    SceneTextStyle cap = st;
    cap.max_lines = 1;
    scene_text_size(&f, words, cap, &w, &h);
    check("max lines", near(h, lh, 1e-5));
    SceneTextStyle clip = st;
    clip.clip = true;
    clip.height = lh * 2.5;
    scene_text_size(&f, "a\nb\nc\nd", clip, &w, &h);
    check("clipped to the box", near(h, 2.0 * lh, 1e-5));

    Gpu gpu = gpu_open()?;
    defer gpu.release();
    Scene scene = gpu.scene()?;
    defer scene.release();
    scene.post.gamma = false;

    // justify: every line but the last spans the box
    SceneTextStyle js = st;
    js.line_break = SCENE_TEXT_JUSTIFY;
    SceneText jt = scene.add_text(0, &f, words, js)?;
    *SceneMesh jm = &scene.meshes.data[jt.mesh];
    check("justified from the left side", jt.lines >= 2 && jm.min.x < -0.45 && jm.max.x <= 0.5 + 1e-4);
    // ViroReact's Knuth-Plass: every line but the last, with the space it breaks at, spans
    // the box exactly, its spaces stretched at most to 3 (tolerance 4 of a half-space
    // stretch), and more evenly than a greedy fill
    string para = "The quick brown fox jumps over the lazy dog while a small cat watches from the old wooden fence near the river bank";
    List<uint32> pc;
    for (i in 0..strlen(para)) List_push(&pc, (uint32)(uint8)para[i]);
    SceneTextStyle ks = js;
    ks.width = 2.4;
    _SceneTextLayout kl;
    _scene_text_layout(&f, &pc, &ks, &kl);
    float space = (float)f.advance(f.glyph(32)) * f.scale(18.0) * 0.01;
    bool exact = kl.lines.size >= 3;
    float kp_worst = 0.0;
    for (li in 0..kl.lines.size - 1) {
        _SceneTextLine ln = kl.lines.data[li];
        float lw = 0.0;
        for (k in 0..ln.count) {
            uint32 c = kl.cps.data[ln.start + k];
            float a = (float)f.advance(f.glyph(c)) * f.scale(18.0) * 0.01;
            lw += c == 32 ? a * ln.spacing : a;
        }
        if (!near(lw, 2.4, 1e-4) || kl.cps.data[ln.start + ln.count - 1] != 32) exact = false;
        if (ln.spacing > kp_worst) kp_worst = ln.spacing;
    }
    check("justified lines span the box with their break space", exact);
    check("spaces within the tolerance", kp_worst <= 3.0001 && kl.lines.data[kl.lines.size - 1].spacing == 1.0);
    // the same breaks a greedy fill would make, stretched the same way
    SceneTextStyle gs = ks;
    gs.line_break = SCENE_TEXT_WORD_WRAP;
    _SceneTextLayout gl;
    _scene_text_layout(&f, &pc, &gs, &gl);
    float g_cost = kp_demerits(&f, &gl, 2.4);
    float k_cost = kp_demerits(&f, &kl, 2.4);
    printf("  justify: %d lines, worst spacing %.3f, demerits %.0f (greedy %.0f, %d lines)\n", kl.lines.size, (double)kp_worst, (double)k_cost, (double)g_cost, gl.lines.size);
    check("far fewer demerits than greedy", k_cost * 100.0 < g_cost);
    _scene_text_free_layout(&kl);
    _scene_text_free_layout(&gl);
    pc.free();

    // alignment: a left, top aligned word starts at the box's left edge, its first line
    // below the top edge
    SceneText t = scene.add_text(0, &f, "Ag", st)?;
    *SceneMesh m = &scene.meshes.data[t.mesh];
    check("left aligned", m.min.x >= -0.5 && m.min.x < -0.45);
    check("top aligned within the box", m.max.y <= 0.5 + 1e-4 && m.max.y > 0.5 - lh);
    SceneTextStyle cc = st;
    cc.align = SCENE_TEXT_CENTER;
    cc.valign = SCENE_TEXT_MIDDLE;
    t.set(&scene, &f, "Ag", cc)?;
    m = &scene.meshes.data[t.mesh];
    check("centered", near((m.min.x + m.max.x) * 0.5, 0.0, 0.02) && m.max.y > 0.0 && m.min.y < 0.0);
    int mesh = t.mesh;
    t.set(&scene, &f, "", cc)?;
    check("empty text draws nothing", scene.node(t.node).mesh == 0 && t.lines == 0);
    t.set(&scene, &f, "Hi", cc)?;
    check("rebuilt into the same mesh", t.mesh == mesh && scene.node(t.node).mesh == mesh);
    scene.remove(jt.node);

    // drawn: white glyphs on black, only inside the text's bounds
    int cam = scene.add_camera(0, scene_orthographic(1.0, 0.1, 10.0));
    scene.node(cam).position = Vec3{0.0, 0.0, 2.0};
    scene.set_camera(cam);
    SceneTextStyle big = cc;
    big.size = 40.0;
    t.set(&scene, &f, "H", big)?;
    GpuTexture target = gpu.target_with((uint32)N, (uint32)N, WGPUTextureFormat_RGBA16Float)?;
    defer target.release();
    *uint16 px = alloc<uint16>(N * N * 4);
    defer free(px);
    scene.render_to(&target)?;
    target.read(px)?;
    m = &scene.meshes.data[t.mesh];
    int lit = 0;
    int stray = 0;
    for (y in 0..N) {
        for (x in 0..N) {
            float v = half_to_float(px[(y * N + x) * 4]);
            float wx = ((float)x + 0.5) / (float)N - 0.5;
            float wy = 0.5 - ((float)y + 0.5) / (float)N;
            bool inside = wx >= m.min.x - 0.02 && wx <= m.max.x + 0.02 && wy >= m.min.y - 0.02 && wy <= m.max.y + 0.02;
            if (v > 0.5) {
                if (inside) lit++;
                else stray++;
            }
        }
    }
    check("glyph drawn", lit > 20);
    check("nothing outside the glyph's bounds", stray == 0);

    // an outline 4 points wide: its quads 0.04 larger on every side, blue around the red
    // glyph, drawn behind it
    SceneTextStyle os = big;
    os.color = Vec4{1.0, 0.0, 0.0, 1.0};
    os.stroke = SCENE_TEXT_STROKE_OUTLINE;
    os.stroke_width = 4.0;
    os.stroke_color = Vec4{0.0, 0.0, 1.0, 1.0};
    t.set(&scene, &f, "H", os)?;
    m = &scene.meshes.data[t.mesh];
    *SceneMesh sm = &scene.meshes.data[t.stroke_mesh];
    check("outline around the glyph", near(sm.min.x, m.min.x - 0.04, 0.001) && near(sm.max.x, m.max.x + 0.04, 0.001) &&
        near(sm.min.y, m.min.y - 0.04, 0.001) && near(sm.max.y, m.max.y + 0.04, 0.001));
    check("drawn before the text", scene.node(t.stroke_node).rendering_order < scene.node(t.node).rendering_order);
    scene.render_to(&target)?;
    target.read(px)?;
    float edge_x = m.min.x - 0.02;
    int ex = (int)((edge_x + 0.5) * (float)N);
    int sx = (int)((m.min.x + 0.015 + 0.5) * (float)N);
    *uint16 pe = px + (32 * N + ex) * 4;
    *uint16 ps = px + (32 * N + sx) * 4;
    check("blue just outside the stem", half_to_float(pe[2]) > 0.5 && half_to_float(pe[0]) < 0.5);
    check("red on the stem", half_to_float(ps[0]) > 0.5 && half_to_float(ps[2]) < 0.5);
    // a drop shadow keeps the glyph's top left and reaches 0.08 to the right and down
    os.stroke = SCENE_TEXT_STROKE_DROP_SHADOW;
    t.set(&scene, &f, "H", os)?;
    m = &scene.meshes.data[t.mesh];
    sm = &scene.meshes.data[t.stroke_mesh];
    check("drop shadow down and right", near(sm.min.x, m.min.x, 0.001) && near(sm.max.x, m.max.x + 0.08, 0.001) &&
        near(sm.min.y, m.min.y - 0.08, 0.001) && near(sm.max.y, m.max.y, 0.001));

    // extruded: front at 0.01 x 10, back at 0, sides between; the front's area matches the
    // flat glyph's (holes kept), and no stroke
    os.stroke = SCENE_TEXT_STROKE_NONE;
    t.set(&scene, &f, "B", os)?;
    scene.render_to(&target)?;
    target.read(px)?;
    int flat_lit = 0;
    for (i in 0..N * N) {
        if (half_to_float(px[i * 4]) > 0.5) flat_lit++;
    }
    SceneTextStyle xs = os;
    xs.extrusion = 10.0;
    t.set(&scene, &f, "B", xs)?;
    *SceneMesh fm = &scene.meshes.data[t.mesh];
    *SceneMesh bm = &scene.meshes.data[t.back_mesh];
    *SceneMesh dm = &scene.meshes.data[t.side_mesh];
    check("front at the extrusion depth", near(fm.min.z, 0.1, 1e-5) && near(fm.max.z, 0.1, 1e-5));
    check("back at 0", near(bm.min.z, 0.0, 1e-5) && near(bm.max.z, 0.0, 1e-5));
    check("sides span it", near(dm.min.z, 0.0, 1e-5) && near(dm.max.z, 0.1, 1e-5));
    check("no stroke on extruded text", scene.node(t.stroke_node).mesh == 0);
    scene.render_to(&target)?;
    target.read(px)?;
    int solid_lit = 0;
    for (i in 0..N * N) {
        if (half_to_float(px[i * 4]) > 0.5) solid_lit++;
    }
    check("the extruded face covers what the flat glyph does", solid_lit > 0 && (float)solid_lit < (float)flat_lit * 1.2 && (float)solid_lit > (float)flat_lit * 0.8);
    xs.extrusion = 0.0;
    t.set(&scene, &f, "B", xs)?;
    check("flat again", scene.node(t.back_node).mesh == 0 && scene.node(t.side_node).mesh == 0 && scene.material(t.material).diffuse_texture == t.texture);
    return Ok<int, string>(0);
}

int main() {
    Result<int, string> r = run();
    if (!r.ok) {
        printf("FAIL %s\n", r.error);
        return 1;
    }
    if (fails > 0) return 1;
    printf("text: ok\n");
    return 0;
}
